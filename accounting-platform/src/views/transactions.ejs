<header class="mb-8">
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Journal — <%= currentBusinessUnit %></p>
  <h1 class="font-display text-3xl mt-1">Transactions</h1>
  <p class="text-ink/50 text-sm mt-1">Most recent entries first, for the selected business unit. Every sale posts two events; every purchase posts one.</p>
</header>

<% if (chartData && chartData.length > 0) { %>
<section class="bg-white rounded-xl border border-ink/10 p-6 mb-8">
  <div class="flex items-center justify-between mb-1">
    <h2 class="font-display text-lg">Cost &amp; Cash Movement Over Time</h2>
    <div class="flex items-center gap-3 text-xs font-mono">
      <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm bg-clay inline-block"></span>Fixed cost</span>
      <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm bg-till/60 inline-block"></span>Variable cost</span>
      <span class="flex items-center gap-1"><span class="w-3 h-0.5 bg-ink inline-block"></span>Net cash</span>
    </div>
  </div>
  <p class="text-ink/50 text-xs mb-4">Fixed costs (rent, salaries, insurance) don't move with sales volume — variable costs (utilities, transport, tax) do. Seeing them stacked against day-to-day net cash movement makes the effect of each transaction easier to read than the raw Journal below.</p>

  <%
    const chartWidth = 900, chartHeight = 220, padding = 40;
    const maxCost = Math.max(1, ...chartData.map(d => d.fixed + d.variable + d.mixed));
    const maxAbsCash = Math.max(1, ...chartData.map(d => Math.abs(d.netCash)));
    const barWidth = Math.max(4, (chartWidth - padding * 2) / chartData.length - 4);
    const barScale = (chartHeight - padding * 2) / maxCost;
    const cashScale = (chartHeight - padding * 2) / 2 / maxAbsCash;
    const cashMidY = padding + (chartHeight - padding * 2) / 2;
  %>
  <svg viewBox="0 0 <%= chartWidth %> <%= chartHeight %>" class="w-full" style="max-height: 260px;">
    <line x1="<%= padding %>" y1="<%= chartHeight - padding %>" x2="<%= chartWidth - padding %>" y2="<%= chartHeight - padding %>" stroke="#00000015" stroke-width="1" />
    <line x1="<%= padding %>" y1="<%= cashMidY %>" x2="<%= chartWidth - padding %>" y2="<%= cashMidY %>" stroke="#00000010" stroke-width="1" stroke-dasharray="2,2" />

    <% chartData.forEach(function(d, i) { %>
      <%
        const x = padding + i * ((chartWidth - padding * 2) / chartData.length) + 2;
        const fixedHeight = d.fixed * barScale;
        const variableHeight = d.variable * barScale;
        const mixedHeight = d.mixed * barScale;
        const baseY = chartHeight - padding;
      %>
      <rect x="<%= x %>" y="<%= baseY - fixedHeight %>" width="<%= barWidth %>" height="<%= fixedHeight %>" fill="#c96a4d" />
      <rect x="<%= x %>" y="<%= baseY - fixedHeight - variableHeight %>" width="<%= barWidth %>" height="<%= variableHeight %>" fill="#3d8a6e99" />
      <rect x="<%= x %>" y="<%= baseY - fixedHeight - variableHeight - mixedHeight %>" width="<%= barWidth %>" height="<%= mixedHeight %>" fill="#8a8a8a66" />
      <title><%= d.date %>: Fixed <%= fmt(d.fixed) %>, Variable <%= fmt(d.variable) %>, Net Cash <%= fmt(d.netCash) %></title>
    <% }) %>

    <polyline
      points="<%= chartData.map((d, i) => {
        const x = padding + i * ((chartWidth - padding * 2) / chartData.length) + 2 + barWidth / 2;
        const y = cashMidY - (d.netCash * cashScale);
        return x + ',' + y;
      }).join(' ') %>"
      fill="none" stroke="#1a1a1a" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"
    />
    <% chartData.forEach(function(d, i) { %>
      <%
        const x = padding + i * ((chartWidth - padding * 2) / chartData.length) + 2 + barWidth / 2;
        const y = cashMidY - (d.netCash * cashScale);
      %>
      <circle cx="<%= x %>" cy="<%= y %>" r="2.5" fill="#1a1a1a" />
    <% }) %>

    <text x="<%= padding %>" y="14" font-size="9" fill="#00000060" font-family="monospace"><%= chartData[0].date %></text>
    <text x="<%= chartWidth - padding %>" y="14" font-size="9" fill="#00000060" font-family="monospace" text-anchor="end"><%= chartData[chartData.length - 1].date %></text>
  </svg>
</section>
<% } %>

<div class="bg-white rounded-xl border border-ink/10 overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
        <th class="px-5 py-3">Date</th>
        <th class="px-5 py-3">Account</th>
        <th class="px-5 py-3">Description</th>
        <th class="px-5 py-3 text-right">Debit</th>
        <th class="px-5 py-3 text-right">Credit</th>
        <th class="px-5 py-3"></th>
      </tr>
    </thead>
    <tbody>
      <% entries.forEach(function(j, i) { %>
        <tr class="border-b border-ink/5 last:border-0 hover:bg-paper/50">
          <td class="px-5 py-3 font-mono text-xs text-ink/50 whitespace-nowrap"><%= j.date %></td>
          <td class="px-5 py-3 font-display"><%= j.accountName %></td>
          <td class="px-5 py-3 text-ink/60"><%= j.description %></td>
          <td class="px-5 py-3 text-right font-mono tabular-nums"><%= j.debit > 0 ? j.debit.toFixed(2) : '' %></td>
          <td class="px-5 py-3 text-right font-mono tabular-nums"><%= j.credit > 0 ? j.credit.toFixed(2) : '' %></td>
          <td class="px-5 py-3 text-right">
            <% if (j.transactionId) { %>
              <button type="button" onclick="toggleNote(<%= i %>)" class="text-xs text-till hover:underline">+ Note</button>
            <% } %>
            <% if (j.recordsId) { %>
              <a href="/documents/receipt/<%= j.recordsId %>" target="_blank" class="text-xs text-ink/50 hover:underline ml-2">Print Receipt</a>
            <% } %>
            <% if (typeof currentUser !== 'undefined' && currentUser && (currentUser.Access_Level === 'OWNER_FULL' || currentUser.Access_Level === 'ACCOUNTANT') && j.correctionStatus === 'ORIGINAL') { %>
              <button type="button" onclick="openCorrect(<%= j.journalId %>, '<%= j.description.replace(/'/g, "\\'") %>')" class="text-xs text-clay hover:underline ml-2">Correct</button>
            <% } %>
          </td>
        </tr>
        <% if (j.transactionId) { %>
          <tr id="note-row-<%= i %>" class="hidden border-b border-ink/5 bg-paper/40">
            <td colspan="6" class="px-5 py-3">
              <form onsubmit="submitNote(event, <%= j.transactionId %>, <%= i %>)" class="flex gap-2 items-start">
                <textarea name="explanation" rows="2" placeholder="Why did this happen? What should the next person know?" required
                  class="flex-1 border border-ink/20 rounded-lg px-3 py-2 text-sm font-display"></textarea>
                <button type="submit" class="px-4 py-2 rounded-lg bg-till text-paper text-xs font-medium hover:brightness-110 transition whitespace-nowrap">Save Note</button>
              </form>
              <p id="note-feedback-<%= i %>" class="hidden text-xs mt-2"></p>
            </td>
          </tr>
        <% } %>
      <% }) %>
      <% if (entries.length === 0) { %>
        <tr><td colspan="6" class="px-5 py-8 text-center text-ink/40">No journal entries yet. Ring up a sale on the Till.</td></tr>
      <% } %>
    </tbody>
    <% if (entries.length > 0) { %>
      <tfoot>
        <tr class="border-t-2 border-ink/10 font-mono text-xs uppercase tracking-widest text-ink/40">
          <td class="px-5 py-3" colspan="3">Totals</td>
          <td class="px-5 py-3 text-right tabular-nums"><%= totals.debit.toFixed(2) %></td>
          <td class="px-5 py-3 text-right tabular-nums"><%= totals.credit.toFixed(2) %></td>
          <td></td>
        </tr>
      </tfoot>
    <% } %>
  </table>
</div>
<% if (totals.debit !== totals.credit) { %>
  <p class="mt-4 text-clay text-sm font-mono">⚠ Debits and credits do not match — out of balance by <%= Math.abs(totals.debit - totals.credit).toFixed(2) %>.</p>
<% } %>

<script>
  function toggleNote(i) {
    document.getElementById("note-row-" + i).classList.toggle("hidden");
  }

  async function submitNote(e, transactionId, i) {
    e.preventDefault();
    const form = e.target;
    const feedback = document.getElementById("note-feedback-" + i);
    const textarea = form.querySelector("textarea");
    const btn = form.querySelector("button");
    btn.disabled = true;
    btn.textContent = "Saving...";
    try {
      const res = await fetch("/api/knowledge", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ explanation: textarea.value, transactionId }),
      });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to save note");
      feedback.textContent = "Note saved.";
      feedback.className = "text-xs mt-2 text-till";
      feedback.classList.remove("hidden");
      textarea.value = "";
    } catch (err) {
      feedback.textContent = err.message;
      feedback.className = "text-xs mt-2 text-clay";
      feedback.classList.remove("hidden");
    } finally {
      btn.disabled = false;
      btn.textContent = "Save Note";
    }
  }
</script>

<!-- Correction modal -->
<div id="correct-modal" class="hidden fixed inset-0 bg-ink/40 flex items-center justify-center z-50 p-4" onclick="if(event.target === this) closeCorrect()">
  <div class="bg-white rounded-xl p-6 max-w-md w-full">
    <h3 class="font-display text-lg mb-1">Correct This Entry</h3>
    <p id="correct-original-desc" class="text-ink/50 text-sm mb-1 font-mono"></p>
    <p class="text-ink/50 text-sm mb-4">The original entry is never deleted — it stays visible, marked as reversed. A new, balanced entry reverses it, referencing the original.</p>
    <form id="correct-form" class="space-y-4">
      <input type="hidden" id="correct-journal-id" />
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Reason (required)</label>
        <textarea id="correct-reason" rows="3" required placeholder="What was wrong, and what the correct position is" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display"></textarea>
      </div>
      <div class="flex gap-2">
        <button type="button" onclick="closeCorrect()" class="flex-1 py-2.5 rounded-lg border border-ink/20 font-display hover:bg-paper transition">Cancel</button>
        <button type="submit" id="correct-submit" class="flex-1 py-2.5 rounded-lg bg-clay text-paper font-display hover:brightness-110 transition">Reverse Entry</button>
      </div>
      <div id="correct-feedback" class="hidden text-sm p-3 rounded-lg"></div>
    </form>
  </div>
</div>

<script>
  function openCorrect(journalId, description) {
    document.getElementById("correct-journal-id").value = journalId;
    document.getElementById("correct-original-desc").textContent = description;
    document.getElementById("correct-reason").value = "";
    document.getElementById("correct-modal").classList.remove("hidden");
    document.getElementById("correct-feedback").classList.add("hidden");
  }
  function closeCorrect() {
    document.getElementById("correct-modal").classList.add("hidden");
  }

  document.getElementById("correct-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    const submitBtn = document.getElementById("correct-submit");
    const feedback = document.getElementById("correct-feedback");
    submitBtn.disabled = true;
    submitBtn.textContent = "Reversing...";
    try {
      const res = await fetch("/api/corrections", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          originalJournalId: document.getElementById("correct-journal-id").value,
          reason: document.getElementById("correct-reason").value,
        }),
      });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to post correction");
      feedback.textContent = `Reversed ${result.reversedCount} entries.`;
      feedback.className = "text-sm p-3 rounded-lg bg-till/10 text-till";
      feedback.classList.remove("hidden");
      setTimeout(() => location.reload(), 900);
    } catch (err) {
      feedback.textContent = err.message;
      feedback.className = "text-sm p-3 rounded-lg bg-clay/10 text-clay";
      feedback.classList.remove("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = "Reverse Entry";
    }
  });
</script>
