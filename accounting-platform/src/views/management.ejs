<header class="mb-8">
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Organisation</p>
  <h1 class="font-display text-3xl mt-1">Management</h1>
  <p class="text-ink/50 text-sm mt-1">Who has a role in running the business, and what they can access.</p>
</header>

<section class="bg-white rounded-xl border border-ink/10 p-6 mb-8 max-w-lg">
  <h2 class="font-display text-xl mb-1">Add Management Role</h2>
  <p class="text-ink/50 text-sm mb-4">Links an existing Stakeholder to a role and access level. Login credentials are set up separately.</p>
  <form id="management-form" class="space-y-4">
    <div>
      <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Stakeholder</label>
      <select name="stakeholderId" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
        <% availableStakeholders.forEach(function(s) { %>
          <option value="<%= s.id %>"><%= s.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Role</label>
        <input name="role" type="text" placeholder="e.g. Manager, Cashier" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display" />
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Access Level</label>
        <select name="accessLevel" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono">
          <option value="VIEWER">Viewer</option>
          <option value="CASHIER">Cashier</option>
          <option value="MANAGER">Manager</option>
          <option value="ACCOUNTANT">Accountant</option>
          <option value="ADVISOR">Advisor</option>
          <option value="OWNER_FULL">Owner (Full)</option>
        </select>
      </div>
    </div>
    <button type="submit" id="submit-btn" class="w-full py-3 rounded-lg bg-till text-paper font-display text-lg hover:brightness-110 transition">
      Add Management Role
    </button>
    <div id="feedback" class="hidden text-sm p-3 rounded-lg"></div>
  </form>
</section>

<section>
  <h2 class="font-display text-xl mb-4">All Management Roles (<%= managementRows.length %>)</h2>
  <div class="bg-white rounded-xl border border-ink/10 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
          <th class="px-5 py-3">Name</th>
          <th class="px-5 py-3">Role</th>
          <th class="px-5 py-3">Access Level</th>
          <th class="px-5 py-3">Succession Status</th>
          <th class="px-5 py-3">Login</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% managementRows.forEach(function(m) { %>
          <% const isLastOwner = m.accessLevel === 'OWNER_FULL' && ownerCount <= 1; %>
          <tr class="border-b border-ink/5 last:border-0 hover:bg-paper/50">
            <td class="px-5 py-3 font-display">
              <%= m.name %>
              <% if (m.id === currentUserId) { %><span class="text-xs text-ink/30 ml-1">(you)</span><% } %>
            </td>
            <td class="px-5 py-3 text-ink/60"><%= m.role || '—' %></td>
            <td class="px-5 py-3">
              <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-paper text-ink/60"><%= m.accessLevel || '—' %></span>
            </td>
            <td class="px-5 py-3 text-ink/50 text-xs"><%= m.inheritanceStatus || '—' %></td>
            <td class="px-5 py-3 text-ink/40 text-xs"><%= m.username ? '@' + m.username : 'no login' %></td>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <button type="button" onclick="toggleEdit(<%= m.id %>)" class="text-xs text-till hover:underline mr-3">Edit</button>
              <% if (isLastOwner) { %>
                <span class="text-xs text-ink/25" title="Can't delete the only Owner account">Delete</span>
              <% } else { %>
                <button type="button" onclick="deleteUser(<%= m.id %>, '<%= m.name.replace(/'/g, "\\'") %>')" class="text-xs text-clay hover:underline">Delete</button>
              <% } %>
            </td>
          </tr>
          <tr id="edit-row-<%= m.id %>" class="hidden border-b border-ink/5 bg-paper/40">
            <td colspan="6" class="px-5 py-3">
              <% if (isLastOwner) { %>
                <p class="text-xs text-clay">This is the only Owner account — promote someone else to Owner before changing this one.</p>
              <% } %>
              <form onsubmit="submitEdit(event, <%= m.id %>)" class="flex gap-2 items-center flex-wrap">
                <input name="role" type="text" value="<%= m.role || '' %>" placeholder="Role" class="border border-ink/20 rounded-lg px-3 py-1.5 text-sm font-display" />
                <select name="accessLevel" class="border border-ink/20 rounded-lg px-3 py-1.5 text-sm font-mono">
                  <% ['VIEWER','CASHIER','MANAGER','ACCOUNTANT','ADVISOR','OWNER_FULL'].forEach(function(opt) { %>
                    <option value="<%= opt %>" <%= m.accessLevel === opt ? 'selected' : '' %>><%= opt %></option>
                  <% }) %>
                </select>
                <button type="submit" class="px-4 py-1.5 rounded-lg bg-till text-paper text-xs font-medium hover:brightness-110 transition">Save</button>
              </form>
              <p id="edit-feedback-<%= m.id %>" class="hidden text-xs mt-2"></p>
            </td>
          </tr>
        <% }) %>
        <% if (managementRows.length === 0) { %>
          <tr><td colspan="6" class="px-5 py-8 text-center text-ink/40">No management roles yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<script>
  function toggleEdit(id) {
    document.getElementById("edit-row-" + id).classList.toggle("hidden");
  }

  async function submitEdit(e, id) {
    e.preventDefault();
    const form = e.target;
    const feedback = document.getElementById("edit-feedback-" + id);
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch(`/api/management/${id}/edit`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to update");
      feedback.textContent = "Saved.";
      feedback.className = "text-xs mt-2 text-till";
      feedback.classList.remove("hidden");
      setTimeout(() => location.reload(), 700);
    } catch (err) {
      feedback.textContent = err.message;
      feedback.className = "text-xs mt-2 text-clay";
      feedback.classList.remove("hidden");
    }
  }

  async function deleteUser(id, name) {
    if (!confirm(`Remove ${name}'s management role? This can't be undone.`)) return;
    try {
      const res = await fetch(`/api/management/${id}/delete`, { method: "POST" });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to delete");
      location.reload();
    } catch (err) {
      alert(err.message);
    }
  }
</script>

<script>
  const form = document.getElementById("management-form");
  const feedback = document.getElementById("feedback");
  const submitBtn = document.getElementById("submit-btn");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = "Saving...";
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch("/api/management", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ stakeholderId: Number(data.stakeholderId), role: data.role, accessLevel: data.accessLevel }),
      });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to add management role");
      feedback.textContent = "Added.";
      feedback.className = "text-sm p-3 rounded-lg bg-till/10 text-till";
      feedback.classList.remove("hidden");
      form.reset();
      setTimeout(() => location.reload(), 700);
    } catch (err) {
      feedback.textContent = err.message;
      feedback.className = "text-sm p-3 rounded-lg bg-clay/10 text-clay";
      feedback.classList.remove("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = "Add Management Role";
    }
  });
</script>
