<header class="mb-8">
  <a href="/resources" class="text-ink/40 hover:text-till text-sm">← Resources</a>
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mt-2">Resources — <%= currentBusinessUnit %></p>
  <h1 class="font-display text-3xl mt-1">Products</h1>
  <p class="text-ink/50 text-sm mt-1">Goods you stock and sell, services you offer or pay for, utilities with their own billing cycle, and investments the business holds.</p>
</header>

<section class="bg-white rounded-xl border border-ink/10 p-6 mb-8">
  <h2 class="font-display text-xl mb-1">Add to Catalog</h2>
  <p class="text-ink/50 text-sm mb-5">The type you choose determines how this item behaves — goods carry stock and cost of sale, services are one-time, utilities follow a billing cycle.</p>

  <form id="product-form" class="space-y-5">
    <div>
      <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Name</label>
      <input name="name" type="text" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display" />
    </div>

    <div>
      <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Nature</label>
      <div class="flex gap-2">
        <label class="flex-1">
          <input type="radio" name="type" value="Goods" checked class="peer sr-only" />
          <div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg px-4 py-3 text-center cursor-pointer transition">
            <span class="font-display block">Goods</span>
            <span class="text-xs opacity-70">Stocked, sold, tracked</span>
          </div>
        </label>
        <label class="flex-1">
          <input type="radio" name="type" value="Services" class="peer sr-only" />
          <div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg px-4 py-3 text-center cursor-pointer transition">
            <span class="font-display block">Service</span>
            <span class="text-xs opacity-70">One-time, no stock</span>
          </div>
        </label>
        <label class="flex-1">
          <input type="radio" name="type" value="Utility" class="peer sr-only" />
          <div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg px-4 py-3 text-center cursor-pointer transition">
            <span class="font-display block">Utility</span>
            <span class="text-xs opacity-70">Has a billing cycle</span>
          </div>
        </label>
        <label class="flex-1">
          <input type="radio" name="type" value="Investment" class="peer sr-only" />
          <div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg px-4 py-3 text-center cursor-pointer transition">
            <span class="font-display block">Investment</span>
            <span class="text-xs opacity-70">Bond, shares, capital</span>
          </div>
        </label>
      </div>
    </div>

    <div id="utility-cycle-field" class="hidden">
      <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Billing cycle</label>
      <select name="billingCycle" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
        <option value="PREPAID_TOKEN">Prepaid tokens (e.g. electricity)</option>
        <option value="MONTHLY">Monthly bill (e.g. water)</option>
        <option value="PREPAID_REDUCING">Prepaid, draws down over time (e.g. garbage)</option>
        <option value="ONE_TIME">One-time charge</option>
      </select>
    </div>

    <div id="investment-fields" class="hidden grid grid-cols-2 gap-4">
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Interest / Return Rate (%)</label>
        <input name="interestRate" type="number" min="0" step="0.01" placeholder="e.g. 12.5" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Maturity Date (optional)</label>
        <input name="maturityDate" type="date" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div id="goods-category-field">
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Category</label>
        <select name="categoryGoods" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
          <option value="Groceries">Groceries</option>
          <option value="Beverages">Beverages</option>
          <option value="Dairy">Dairy</option>
          <option value="Produce">Produce</option>
          <option value="Bakery">Bakery</option>
          <option value="Meat &amp; Poultry">Meat &amp; Poultry</option>
          <option value="Household">Household</option>
          <option value="Personal Care">Personal Care</option>
          <option value="Stationery">Stationery</option>
          <option value="Hardware">Hardware</option>
          <option value="Agricultural Inputs">Agricultural Inputs</option>
          <option value="Other Goods">Other Goods</option>
        </select>
      </div>
      <div id="services-category-field" class="hidden">
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Category</label>
        <select name="categoryServices" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
          <option value="Repairs &amp; Maintenance">Repairs &amp; Maintenance</option>
          <option value="Delivery &amp; Transport">Delivery &amp; Transport</option>
          <option value="Professional Services">Professional Services</option>
          <option value="Rental &amp; Hire">Rental &amp; Hire</option>
          <option value="Installation">Installation</option>
          <option value="Consultation">Consultation</option>
          <option value="Other Services">Other Services</option>
        </select>
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Unit</label>
        <input name="unit" type="text" placeholder="e.g. kg, unit, token" value="unit" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1" id="price-label">Selling price (KES)</label>
        <input name="price" type="number" min="0" step="0.01" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1" id="cost-label">Cost (KES)</label>
        <input name="cost" type="number" min="0" step="0.01" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
    </div>

    <div id="stock-fields" class="grid grid-cols-2 gap-4">
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Starting stock</label>
        <input name="startingStock" type="number" min="0" step="0.001" value="0" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Reorder level</label>
        <input name="reorderLevel" type="number" min="0" step="0.001" value="10" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
    </div>

    <button type="submit" id="submit-btn" class="w-full py-3 rounded-lg bg-till text-paper font-display text-lg hover:brightness-110 transition">
      Add to Catalog
    </button>
    <div id="feedback" class="hidden text-sm p-3 rounded-lg"></div>
  </form>
</section>

<section>
  <h2 class="font-display text-xl mb-4">Catalog</h2>
  <div class="bg-white rounded-xl border border-ink/10 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
          <th class="px-5 py-3">Product</th>
          <th class="px-5 py-3">Nature</th>
          <th class="px-5 py-3 text-right">Stock</th>
          <th class="px-5 py-3 text-right">Price</th>
          <th class="px-5 py-3 text-right">Cost</th>
          <th class="px-5 py-3 text-right">Margin</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(function(p) { %>
          <tr class="border-b border-ink/5 last:border-0 hover:bg-paper/50">
            <td class="px-5 py-3 font-display"><%= p.name %></td>
            <td class="px-5 py-3 text-ink/50">
              <%= p.isUtility ? 'Utility · ' + (p.billingCycle || '').replace(/_/g, ' ') : (p.type || '—') %>
            </td>
            <td class="px-5 py-3 text-right font-mono tabular-nums <%= p.isUtility || p.type === 'Services' || p.type === 'Investment' ? 'text-ink/20' : (p.stock <= 5 ? 'text-clay' : '') %>">
              <%= p.isUtility || p.type === 'Services' || p.type === 'Investment' ? '—' : p.stock %>
            </td>
            <td class="px-5 py-3 text-right font-mono tabular-nums"><%= p.price.toFixed(2) %></td>
            <td class="px-5 py-3 text-right font-mono tabular-nums text-ink/50"><%= p.cost.toFixed(2) %></td>
            <td class="px-5 py-3 text-right font-mono tabular-nums text-till">
              <%= p.price > 0 ? (((p.price - p.cost) / p.price) * 100).toFixed(0) + '%' : '—' %>
            </td>
          </tr>
        <% }) %>
        <% if (products.length === 0) { %>
          <tr><td colspan="6" class="px-5 py-8 text-center text-ink/40">Nothing in the catalog for <%= currentBusinessUnit %> yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<script>
  const form = document.getElementById("product-form");
  const feedback = document.getElementById("feedback");
  const submitBtn = document.getElementById("submit-btn");
  const utilityField = document.getElementById("utility-cycle-field");
  const investmentFields = document.getElementById("investment-fields");
  const stockFields = document.getElementById("stock-fields");
  const goodsCategoryField = document.getElementById("goods-category-field");
  const servicesCategoryField = document.getElementById("services-category-field");
  const priceLabel = document.getElementById("price-label");
  const costLabel = document.getElementById("cost-label");

  form.addEventListener("change", () => {
    const type = form.querySelector('input[name="type"]:checked').value;
    utilityField.classList.toggle("hidden", type !== "Utility");
    investmentFields.classList.toggle("hidden", type !== "Investment");
    stockFields.classList.toggle("hidden", type !== "Goods");
    // Utility products are stored as type "Services" underneath (see the
    // submit handler), so they use the Services category list too.
    goodsCategoryField.classList.toggle("hidden", type !== "Goods");
    servicesCategoryField.classList.toggle("hidden", type === "Goods" || type === "Investment");
    priceLabel.textContent = type === "Goods" ? "Selling price (KES)" : type === "Investment" ? "Principal Amount (KES)" : "Typical charge (KES)";
    costLabel.textContent = type === "Goods" ? "Cost (KES)" : type === "Investment" ? "Amount Invested (KES)" : "Cost to business (KES)";
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = "Saving...";
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch("/api/products", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: data.name,
          type: data.type === "Utility" ? "Services" : data.type,
          isUtility: data.type === "Utility",
          billingCycle: data.type === "Utility" ? data.billingCycle : null,
          category: data.type === "Goods" ? data.categoryGoods : (data.type === "Investment" ? null : data.categoryServices),
          price: Number(data.price),
          cost: Number(data.cost),
          unit: data.unit,
          startingStock: Number(data.startingStock || 0),
          reorderLevel: Number(data.reorderLevel || 0),
          interestRate: data.type === "Investment" && data.interestRate ? Number(data.interestRate) : null,
          maturityDate: data.type === "Investment" && data.maturityDate ? data.maturityDate : null,
        }),
      });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to add product");
      feedback.textContent = `Added ${data.name} to the catalog.`;
      feedback.className = "text-sm p-3 rounded-lg bg-till/10 text-till";
      feedback.classList.remove("hidden");
      form.reset();
      utilityField.classList.add("hidden");
      investmentFields.classList.add("hidden");
      servicesCategoryField.classList.add("hidden");
      goodsCategoryField.classList.remove("hidden");
      setTimeout(() => location.reload(), 800);
    } catch (err) {
      feedback.textContent = err.message;
      feedback.className = "text-sm p-3 rounded-lg bg-clay/10 text-clay";
      feedback.classList.remove("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = "Add to Catalog";
    }
  });
</script>
