<header class="mb-10">
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Owner Dashboard</p>
  <h1 class="font-display text-4xl mt-1"><%= businessName %></h1>
  <p class="text-ink/50 mt-1"><%= todayLabel %></p>
</header>

<!-- Snapshot ledger -->
<section class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-12">
  <div class="bg-white rounded-xl border border-ink/10 p-5">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Sales Today</p>
    <p class="font-mono text-2xl tabular-nums text-till"><%= fmt(snapshot.salesToday) %></p>
    <p class="text-xs text-ink/40 mt-1"><%= snapshot.saleCount %> transaction<%= snapshot.saleCount === 1 ? '' : 's' %></p>
  </div>
  <div class="bg-white rounded-xl border border-ink/10 p-5">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Purchases Today</p>
    <p class="font-mono text-2xl tabular-nums text-clay"><%= fmt(snapshot.purchasesToday) %></p>
    <p class="text-xs text-ink/40 mt-1"><%= snapshot.purchaseCount %> transaction<%= snapshot.purchaseCount === 1 ? '' : 's' %></p>
  </div>
  <div class="bg-white rounded-xl border border-ink/10 p-5">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Cash Balance</p>
    <p class="font-mono text-2xl tabular-nums"><%= fmt(snapshot.cashBalance) %></p>
    <p class="text-xs text-ink/40 mt-1">Account 1000</p>
  </div>
  <div class="bg-white rounded-xl border border-ink/10 p-5">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Open Period</p>
    <p class="font-display text-lg"><%= snapshot.openPeriodName || 'None' %></p>
    <p class="text-xs <%= snapshot.openPeriodName ? 'text-till' : 'text-clay' %> mt-1">
      <%= snapshot.openPeriodName ? 'Accepting entries' : 'No period open — posting will fail' %>
    </p>
  </div>
  <a href="/settings/alerts" class="bg-white rounded-xl border p-5 hover:shadow-md transition <%= alertCount > 0 ? 'border-clay/30' : 'border-ink/10' %>">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Alerts</p>
    <p class="font-mono text-2xl tabular-nums <%= alertCount > 0 ? 'text-clay' : 'text-till' %>"><%= alertCount %></p>
    <p class="text-xs text-ink/40 mt-1"><%= alertCount > 0 ? 'Needs attention' : 'All clear' %></p>
  </a>
</section>

<!-- Recap cards (sidebar handles primary navigation now) -->
<section>
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-4">At a glance</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4">

    <a href="/pos" class="group bg-till text-paper rounded-xl p-6 hover:brightness-110 transition flex flex-col justify-between h-36">
      <span class="font-display text-xl">Till</span>
      <span class="text-paper/70 text-sm">Ring up sales, receive stock</span>
    </a>

    <a href="/assets" class="group bg-clay text-paper rounded-xl p-6 hover:brightness-110 transition flex flex-col justify-between h-36">
      <span class="font-display text-xl">Assets</span>
      <span class="text-paper/70 text-sm">Vehicle, equipment, property</span>
    </a>

    <a href="/expense" class="group bg-white border border-ink/10 rounded-xl p-6 hover:border-till transition flex flex-col justify-between h-36">
      <span class="font-display text-xl">Expenses</span>
      <span class="text-ink/50 text-sm">Rent, salaries, utilities</span>
    </a>

    <a href="/products" class="group bg-white border border-ink/10 rounded-xl p-6 hover:border-till transition flex flex-col justify-between h-36">
      <span class="font-display text-xl"><%= snapshot.productCount %> Products</span>
      <span class="text-ink/50 text-sm">Stock levels, prices, cost</span>
    </a>

    <a href="/transactions" class="group bg-white border border-ink/10 rounded-xl p-6 hover:border-till transition flex flex-col justify-between h-36">
      <span class="font-display text-xl">Transactions</span>
      <span class="text-ink/50 text-sm">Every posted journal entry</span>
    </a>

    <a href="/reports" class="group bg-white border border-ink/10 rounded-xl p-6 hover:border-till transition flex flex-col justify-between h-36">
      <span class="font-display text-xl">Reports</span>
      <span class="text-ink/50 text-sm">Daily record, trial balance</span>
    </a>

    <a href="/accounts" class="group bg-white border border-ink/10 rounded-xl p-6 hover:border-till transition flex flex-col justify-between h-36">
      <span class="font-display text-xl"><%= snapshot.accountCount %> Accounts</span>
      <span class="text-ink/50 text-sm">Chart of accounts</span>
    </a>

  </div>
</section>
