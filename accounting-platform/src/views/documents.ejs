<header class="mb-8">
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Insights — <%= currentBusinessUnit %></p>
  <h1 class="font-display text-3xl mt-1">Documents</h1>
  <p class="text-ink/50 text-sm mt-1">Receipts generated from real transactions, plus invoices and scans you've uploaded — this is the actual evidence behind the numbers.</p>
</header>

<section class="bg-white rounded-xl border border-ink/10 p-6 mb-8">
  <h2 class="font-display text-lg mb-1">Upload a Document</h2>
  <p class="text-ink/50 text-sm mb-4">A scanned receipt, an invoice PDF, or a photo of a paper record. PDF, JPEG, PNG, or WEBP — up to 10MB.</p>
  <form id="upload-form" class="grid md:grid-cols-2 gap-3" enctype="multipart/form-data">
    <div>
      <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">File</label>
      <input id="upload-file" name="file" type="file" required accept=".pdf,.jpg,.jpeg,.png,.webp" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono text-sm" />
    </div>
    <div>
      <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Type</label>
      <select id="upload-type" name="documentType" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
        <option value="INVOICE">Invoice</option>
        <option value="RECEIPT">Receipt (from a supplier)</option>
        <option value="SCAN">Scan / Photo</option>
        <option value="CONTRACT">Contract</option>
        <option value="OTHER">Other</option>
      </select>
    </div>
    <div>
      <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Title</label>
      <input id="upload-title" name="title" type="text" placeholder="e.g. Egg supplier invoice — July" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display" />
    </div>
    <div>
      <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Amount (optional)</label>
      <input id="upload-amount" name="amount" type="number" min="0" step="0.01" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
    </div>
    <div class="md:col-span-2">
      <button type="submit" id="upload-submit" class="px-4 py-2.5 rounded-lg bg-till text-paper font-display hover:brightness-110 transition">Upload</button>
      <div id="upload-feedback" class="hidden text-sm p-3 rounded-lg mt-2"></div>
    </div>
  </form>
</section>

<div class="bg-white rounded-xl border border-ink/10 overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
        <th class="px-5 py-3">Title</th>
        <th class="px-5 py-3">Type</th>
        <th class="px-5 py-3">Date</th>
        <th class="px-5 py-3 text-right">Amount</th>
        <th class="px-5 py-3">Source</th>
        <th class="px-5 py-3 text-right">File</th>
      </tr>
    </thead>
    <tbody>
      <% documents.forEach(function(d) { %>
        <tr class="border-b border-ink/5 last:border-0 hover:bg-paper/50">
          <td class="px-5 py-3 font-display"><%= d.title %></td>
          <td class="px-5 py-3">
            <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-paper text-ink/50"><%= d.type %></span>
          </td>
          <td class="px-5 py-3 font-mono text-xs text-ink/50"><%= d.date %></td>
          <td class="px-5 py-3 text-right font-mono tabular-nums"><%= d.amount !== null ? fmt(d.amount) : '—' %></td>
          <td class="px-5 py-3">
            <span class="text-xs font-mono px-2 py-0.5 rounded-full <%= d.isGenerated ? 'bg-till/10 text-till' : 'bg-ink/10 text-ink/50' %>"><%= d.isGenerated ? 'Generated' : 'Uploaded' %></span>
          </td>
          <td class="px-5 py-3 text-right">
            <% if (d.filePath) { %>
              <a href="/documents/file/<%= d.id %>" target="_blank" class="text-till hover:underline text-xs">View</a>
            <% } else { %>
              <span class="text-ink/30 text-xs">—</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (documents.length === 0) { %>
        <tr><td colspan="6" class="px-5 py-8 text-center text-ink/40">No documents yet for <%= currentBusinessUnit %>. Upload one above, or find "Print Receipt" on a Transactions entry.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<script>
  const uploadForm = document.getElementById("upload-form");
  const uploadFeedback = document.getElementById("upload-feedback");
  const uploadSubmit = document.getElementById("upload-submit");

  uploadForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    uploadSubmit.disabled = true;
    uploadSubmit.textContent = "Uploading...";
    const formData = new FormData(uploadForm);
    try {
      const res = await fetch("/documents/upload", { method: "POST", body: formData });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to upload");
      uploadFeedback.textContent = "Uploaded.";
      uploadFeedback.className = "text-sm p-3 rounded-lg mt-2 bg-till/10 text-till";
      uploadFeedback.classList.remove("hidden");
      setTimeout(() => location.reload(), 800);
    } catch (err) {
      uploadFeedback.textContent = err.message;
      uploadFeedback.className = "text-sm p-3 rounded-lg mt-2 bg-clay/10 text-clay";
      uploadFeedback.classList.remove("hidden");
      uploadSubmit.disabled = false;
      uploadSubmit.textContent = "Upload";
    }
  });
</script>
