<header class="mb-8">
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Books of Entry</p>
  <h1 class="font-display text-3xl mt-1">Ledger</h1>
  <p class="text-ink/50 text-sm mt-1">Every account's own history, with a running balance — the same entries as the Journal, reorganised by account.</p>
</header>

<% if (accounts.length === 0) { %>
  <div class="bg-white rounded-xl border border-ink/10 p-8 text-center text-ink/40">No accounts with activity yet.</div>
<% } %>

<div class="space-y-6">
  <% accounts.forEach(function(acc) { %>
    <section class="bg-white rounded-xl border border-ink/10 overflow-hidden">
      <div class="px-5 py-3 border-b border-ink/10 flex items-center justify-between bg-paper/40">
        <div>
          <p class="font-display text-lg"><%= acc.name %></p>
          <p class="text-xs text-ink/40 font-mono"><%= acc.code || '—' %> · <%= acc.type %></p>
        </div>
        <div class="text-right">
          <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Balance</p>
          <p class="font-mono text-lg tabular-nums <%= acc.balance >= 0 ? '' : 'text-clay' %>"><%= acc.balance.toFixed(2) %></p>
        </div>
      </div>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
            <th class="px-5 py-2">Date</th>
            <th class="px-5 py-2">Description</th>
            <th class="px-5 py-2 text-right">Debit</th>
            <th class="px-5 py-2 text-right">Credit</th>
            <th class="px-5 py-2 text-right">Running Balance</th>
          </tr>
        </thead>
        <tbody>
          <% acc.entries.forEach(function(e) { %>
            <tr class="border-b border-ink/5 last:border-0">
              <td class="px-5 py-2 font-mono text-xs text-ink/50 whitespace-nowrap"><%= e.date %></td>
              <td class="px-5 py-2 text-ink/60"><%= e.description %></td>
              <td class="px-5 py-2 text-right font-mono tabular-nums"><%= e.debit > 0 ? e.debit.toFixed(2) : '' %></td>
              <td class="px-5 py-2 text-right font-mono tabular-nums"><%= e.credit > 0 ? e.credit.toFixed(2) : '' %></td>
              <td class="px-5 py-2 text-right font-mono tabular-nums text-ink/70"><%= e.runningBalance.toFixed(2) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  <% }) %>
</div>
