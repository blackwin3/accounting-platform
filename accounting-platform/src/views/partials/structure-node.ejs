<% if (s.type !== 'ACCOUNTING_PERIOD') { %>
<div class="<%= depth > 0 ? 'ml-6 border-l border-ink/10 pl-4' : '' %> mb-3">
  <div class="bg-white rounded-xl border border-ink/10 p-4 flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-paper text-ink/50"><%= s.type %></span>
        <p class="font-display"><%= s.name %></p>
      </div>
      <% if (s.description) { %><p class="text-ink/50 text-xs"><%= s.description %></p><% } %>
      <% if (s.standardReference) { %><p class="text-xs font-mono text-till mt-1"><%= s.standardReference %></p><% } %>
    </div>
    <div class="flex items-center gap-3 flex-shrink-0">
      <form method="POST" action="/settings/structures/<%= s.id %>/rule-severity" class="flex items-center gap-2">
        <select name="Rule_Severity" class="text-xs font-mono border border-ink/20 rounded px-2 py-1 bg-paper">
          <% ['BLOCK','WARN','INFO'].forEach(function(opt) { %>
            <option value="<%= opt %>" <%= s.ruleSeverity === opt ? 'selected' : '' %>><%= opt %></option>
          <% }) %>
        </select>
        <button type="submit" class="text-xs px-2 py-1 rounded bg-ink/10 hover:bg-ink/20">Save</button>
      </form>
      <span class="text-ink/30 text-xs">#<%= s.id %></span>
    </div>
  </div>
  <% (childrenOf[s.id] || []).forEach(function(child) { %>
    <%- include('structure-node', { s: child, depth: depth + 1, childrenOf: childrenOf }) %>
  <% }) %>
</div>
<% } else { %>
  <%# ACCOUNTING_PERIOD rows are owned entirely by the Trading Days
      calendar and its period list further up this page — rendering them
      here too would show every trading day twice, once cleanly in the
      calendar and once as an awkward generic tree node. Children (if
      any) still need to render even when the period row itself doesn't,
      so a period never silently loses its sub-structure. %>
  <% (childrenOf[s.id] || []).forEach(function(child) { %>
    <%- include('structure-node', { s: child, depth: depth, childrenOf: childrenOf }) %>
  <% }) %>
<% } %>
