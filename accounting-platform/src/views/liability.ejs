<header class="mb-8">
  <a href="/claims" class="text-ink/40 hover:text-till text-sm">← Claims</a>
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mt-2">Claims — <%= currentBusinessUnit %></p>
  <h1 class="font-display text-3xl mt-1">Liability</h1>
  <p class="text-ink/50 text-sm mt-1">Loans, formal liabilities, and a history of discounts given or taken — discount rows are already settled, shown here for visibility, not because anything is owed.</p>
</header>

<section class="mb-10">
  <div class="bg-white rounded-xl border border-ink/10 p-5 max-w-xs">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Total Outstanding</p>
    <p class="font-mono text-2xl tabular-nums text-clay"><%= fmt(liabilitiesTotal) %></p>
    <p class="text-xs text-ink/40 mt-1">Excludes settled discount history below.</p>
  </div>
</section>

<div class="bg-white rounded-xl border border-ink/10 overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
        <th class="px-5 py-3">Type</th>
        <th class="px-5 py-3">Classification</th>
        <th class="px-5 py-3">Status</th>
        <th class="px-5 py-3 text-right">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% liabilities.forEach(function(l) { %>
        <tr class="border-b border-ink/5 last:border-0 hover:bg-paper/50">
          <td class="px-5 py-3 font-display"><%= l.type %></td>
          <td class="px-5 py-3">
            <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-paper text-ink/50"><%= l.classification || '—' %></span>
          </td>
          <td class="px-5 py-3">
            <% if (l.isSettled) { %>
              <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-till/10 text-till">Settled</span>
            <% } else { %>
              <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-clay/10 text-clay">Outstanding</span>
            <% } %>
          </td>
          <td class="px-5 py-3 text-right font-mono tabular-nums <%= l.isSettled ? 'text-ink/50' : 'text-clay' %>"><%= fmt(l.amount) %></td>
        </tr>
      <% }) %>
      <% if (liabilities.length === 0) { %>
        <tr><td colspan="4" class="px-5 py-8 text-center text-ink/40">No liabilities recorded for <%= currentBusinessUnit %> yet. Loans are added from Money → Add Funds.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
