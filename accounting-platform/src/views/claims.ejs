<header class="mb-8">
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Claims — <%= currentBusinessUnit %></p>
  <h1 class="font-display text-3xl mt-1">Claims</h1>
  <p class="text-ink/50 text-sm mt-1">What the business spends and owes.</p>
</header>

<section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
  <div class="bg-white rounded-xl border border-ink/10 p-5">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Expenses This Month</p>
    <p class="font-mono text-2xl tabular-nums text-clay"><%= expensesThisMonth.toFixed(2) %></p>
  </div>
  <div class="bg-white rounded-xl border border-ink/10 p-5">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Expense Entries</p>
    <p class="font-mono text-2xl tabular-nums"><%= expenseCount %></p>
  </div>
  <div class="bg-white rounded-xl border border-ink/10 p-5">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Liabilities Owed</p>
    <p class="font-mono text-2xl tabular-nums text-clay"><%= liabilitiesTotal.toFixed(2) %></p>
  </div>
</section>

<section>
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-4">Go to</p>
  <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-5 gap-4">
    <a href="/expense" class="bg-clay text-paper rounded-xl p-6 hover:brightness-110 transition flex flex-col justify-between h-32">
      <span class="font-display text-xl">Expenses</span>
      <span class="text-paper/70 text-sm">Record, view history, see liabilities</span>
    </a>
    <a href="/payables" class="bg-white border border-ink/10 rounded-xl p-6 hover:border-till transition flex flex-col justify-between h-32">
      <span class="font-display text-xl">Payables</span>
      <span class="text-ink/50 text-sm">Trade receivables and payables</span>
    </a>
    <a href="/liability" class="bg-white border border-ink/10 rounded-xl p-6 hover:border-till transition flex flex-col justify-between h-32">
      <span class="font-display text-xl">Liability</span>
      <span class="text-ink/50 text-sm">Loans and formal liabilities</span>
    </a>
    <a href="/claims/leases-provisions" class="bg-white border border-ink/10 rounded-xl p-6 hover:border-till transition flex flex-col justify-between h-32">
      <span class="font-display text-xl">Leases &amp; Provisions</span>
      <span class="text-ink/50 text-sm">Right-of-Use leases, warranties</span>
    </a>
    <a href="/claims/risks-insurance" class="bg-white border border-ink/10 rounded-xl p-6 hover:border-till transition flex flex-col justify-between h-32">
      <span class="font-display text-xl">Risks &amp; Insurance</span>
      <span class="text-ink/50 text-sm">Provisions monitoring, policies</span>
    </a>
  </div>
</section>
