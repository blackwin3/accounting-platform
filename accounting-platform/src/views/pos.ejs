<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Point of Sale</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            paper: '#F6F3EC',
            ink: '#232019',
            till: '#1F5E45',
            tillDark: '#153F2E',
            clay: '#B45B3C',
          },
          fontFamily: {
            display: ['Georgia', 'serif'],
            mono: ['"Courier New"', 'monospace'],
          },
        },
      },
    };
  </script>
</head>
<body class="bg-paper text-ink min-h-screen font-sans">

  <nav class="border-b-2 border-ink/10 bg-white">
    <div class="px-6 flex items-center justify-between h-12">
      <div class="flex items-center gap-3">
        <a href="/" class="font-display text-base tracking-tight">Nzovu</a>
        <a href="/dashboard" class="text-xs text-ink/50 hover:text-ink px-2 py-1 rounded-full hover:bg-paper transition">← Home</a>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-xs text-ink/50 font-mono"><%= currentUser ? currentUser.Management_Name : '' %> · <%= roleLabel %></span>
        <form method="POST" action="/logout"><button type="submit" class="text-xs text-ink/40 hover:text-clay px-2">Sign out</button></form>
      </div>
    </div>
  </nav>


  <div class="flex flex-col lg:flex-row min-h-[calc(100vh-3rem)]">

    <!-- LEFT: Product grid + mode toggle -->
    <main class="flex-1 p-6 lg:p-10 pb-16">
      <header class="flex items-baseline justify-between mb-8 border-b-2 border-ink/10 pb-4">
        <h1 class="font-display text-3xl tracking-tight">Nzovu — Till</h1>
        <div class="inline-flex rounded-full border border-ink/20 overflow-hidden text-sm font-medium">
          <button id="mode-sell" class="px-5 py-2 bg-till text-paper transition-colors" data-mode="sell">Sell</button>
          <button id="mode-buy" class="px-5 py-2 bg-transparent text-ink/60 hover:text-ink transition-colors" data-mode="buy">Receive Stock</button>
        </div>
      </header>

      <div id="product-grid" class="flex flex-col gap-6">
        <!-- Inventory / Services / Utilities sections injected by JS -->
      </div>
      <p id="product-empty" class="hidden text-ink/50 mt-8 font-display text-lg">
        No products yet. Add rows to the <code class="font-mono text-sm">Product</code> table to get started.
      </p>
    </main>

    <!-- RIGHT: Receipt / ticket panel -->
    <aside class="w-full lg:w-[420px] bg-white shadow-[-8px_0_24px_-12px_rgba(0,0,0,0.15)] flex flex-col">
      <div class="p-6 border-b border-dashed border-ink/20">
        <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Current Ticket</p>
        <p id="mode-label" class="font-display text-xl mt-1">Sale in progress</p>
      </div>

      <div id="ticket-lines" class="flex-1 overflow-y-auto p-6 space-y-3 font-mono text-sm">
        <p class="text-ink/30 italic">Tap a product to add it.</p>
      </div>

      <div class="p-6 bg-tillDark text-paper">
        <div class="mb-4">
          <label class="block font-mono text-xs uppercase tracking-widest text-paper/50 mb-2">Payment Method</label>
          <div class="grid grid-cols-4 gap-1.5">
            <button type="button" data-method="CASH" class="payment-btn px-2 py-2 rounded-lg text-xs font-medium border border-paper/20 transition">Cash</button>
            <button type="button" data-method="MOBILE" class="payment-btn px-2 py-2 rounded-lg text-xs font-medium border border-paper/20 transition">Mobile</button>
            <button type="button" data-method="BANK" class="payment-btn px-2 py-2 rounded-lg text-xs font-medium border border-paper/20 transition">Bank</button>
            <button type="button" data-method="CREDIT" class="payment-btn px-2 py-2 rounded-lg text-xs font-medium border border-paper/20 transition">Credit</button>
          </div>
        </div>
        <div class="mb-4 hidden" id="mobile-reference-section">
          <label class="block font-mono text-xs uppercase tracking-widest text-paper/50 mb-2">Mobile Money Reference</label>
          <input id="mobile-reference-input" type="text" placeholder="e.g. QGH7X2K1P9 · 14:32 · 0712345678"
            class="w-full bg-tillDark border border-paper/20 rounded-lg px-3 py-2 font-mono text-sm text-paper placeholder-paper/30" />
          <p class="text-xs text-paper/40 mt-1">Transaction code, time, and/or sender number — whatever's useful to match against the statement later.</p>
        </div>
        <div class="mb-4 hidden" id="stakeholder-section">
          <label class="block font-mono text-xs uppercase tracking-widest text-paper/50 mb-2" id="stakeholder-label">Customer</label>
          <select id="stakeholder-input" class="w-full bg-tillDark border border-paper/20 rounded-lg px-3 py-2 font-mono text-sm text-paper">
            <option value="">— not specified —</option>
          </select>
          <p class="text-xs text-paper/40 mt-1">Who this credit or discount is for — optional, but useful for chasing it up later.</p>
        </div>
        <div class="mb-4" id="discount-section">
          <label class="flex items-center justify-between font-mono text-xs uppercase tracking-widest text-paper/50 mb-2">
            <span id="discount-label">Discount Given (KES)</span>
          </label>
          <input id="discount-input" type="number" step="0.01" value="0"
            class="w-full bg-tillDark border border-paper/20 rounded-lg px-3 py-2 font-mono text-sm text-paper placeholder-paper/30 disabled:opacity-30 disabled:cursor-not-allowed" placeholder="0.00" />
          <p id="discount-hint" class="text-xs text-paper/40 mt-1">Positive = a discount off the sale. Negative = that amount is on credit, the rest paid via Cash/Mobile/Bank above — a split payment. Not used when Credit is selected below (the whole basket is already on credit).</p>
        </div>
        <% if (typeof currentUser !== 'undefined' && currentUser && (currentUser.Access_Level === 'OWNER_FULL' || currentUser.Access_Level === 'MANAGER')) { %>
        <div class="mb-4">
          <label class="block font-mono text-xs uppercase tracking-widest text-paper/50 mb-2">Notes (optional)</label>
          <input id="notes-input" type="text" placeholder="Any context worth keeping — why a discount, who this is for, anything unusual"
            class="w-full bg-tillDark border border-paper/20 rounded-lg px-3 py-2 font-mono text-sm text-paper placeholder-paper/30" />
        </div>
        <% } %>
        <div class="flex justify-between items-baseline mb-1">
          <span class="font-display text-sm text-paper/60">List Total</span>
          <span id="ticket-total" class="font-mono text-lg tabular-nums text-paper/60">0.00</span>
        </div>
        <div class="flex justify-between items-baseline mb-4">
          <span id="ticket-net-total-label" class="font-display text-lg">Net Total</span>
          <span id="ticket-net-total" class="font-mono text-3xl tabular-nums">0.00</span>
        </div>
        <button id="btn-post" disabled
          class="w-full py-4 rounded-lg bg-clay text-paper font-display text-lg tracking-wide disabled:opacity-40 disabled:cursor-not-allowed hover:brightness-110 transition">
          Complete Sale
        </button>
        <button id="btn-clear" class="w-full mt-2 py-2 text-paper/60 text-sm hover:text-paper transition">
          Clear ticket
        </button>
      </div>

      <div id="feedback" class="p-4 text-sm hidden"></div>
    </aside>
  </div>

  <script>
    let mode = "sell"; // sell | buy
    // Client-side equivalent of the server's res.locals.fmt() helper —
    // this page's totals update live via JS, so they can't rely on the
    // EJS-only server-side formatter for anything computed after page load.
    function fmtNum(n) {
      const num = Number(n || 0);
      const sign = num < 0 ? "-" : "";
      const abs = Math.abs(num);
      const [whole, decimals] = abs.toFixed(2).split(".");
      const withCommas = whole.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
      return `${sign}${withCommas}.${decimals}`;
    }

    let paymentMethod = "CASH";
    let products = { inventory: [], services: [], utilities: [], investments: [] };
    let ticket = []; // { id, name, price, qty }

    const grid = document.getElementById("product-grid");
    const emptyMsg = document.getElementById("product-empty");
    const ticketLines = document.getElementById("ticket-lines");
    const ticketTotal = document.getElementById("ticket-total");
    const btnPost = document.getElementById("btn-post");
    const btnClear = document.getElementById("btn-clear");
    const feedback = document.getElementById("feedback");
    const modeLabel = document.getElementById("mode-label");
    const modeSellBtn = document.getElementById("mode-sell");
    const modeBuyBtn = document.getElementById("mode-buy");
    const paymentBtns = document.querySelectorAll(".payment-btn");

    function setPaymentMethod(method) {
      paymentMethod = method;
      paymentBtns.forEach((btn) => {
        const active = btn.dataset.method === method;
        btn.classList.toggle("bg-paper", active);
        btn.classList.toggle("text-ink", active);
        btn.classList.toggle("text-paper/70", !active);
      });

      const discountInput = document.getElementById("discount-input");
      const discountHint = document.getElementById("discount-hint");
      if (method === "CREDIT") {
        discountInput.value = "0";
        discountInput.disabled = true;
        discountHint.textContent = "Not used when Credit is selected — the whole basket is already on credit. To collect part now and leave the rest owing, choose Cash/Mobile/Bank instead and enter a negative amount here.";
        const total = ticket.reduce((sum, line) => sum + line.qty * line.price, 0);
        updateNetTotal(total);
      } else {
        discountInput.disabled = false;
        discountHint.textContent = "Positive = a discount off the sale. Negative = that amount is on credit, the rest paid via the method selected above — a split payment. Not used when Credit is selected below (the whole basket is already on credit).";
      }

      document.getElementById("mobile-reference-section").classList.toggle("hidden", method !== "MOBILE");
      updateStakeholderVisibility();
    }
    paymentBtns.forEach((btn) => btn.addEventListener("click", () => setPaymentMethod(btn.dataset.method)));

    // The stakeholder picker only matters when there's a real counterparty
    // to track: a full-Credit sale, or a partial-credit split (negative
    // discount). A plain Cash/Mobile/Bank sale with no credit involved has
    // no one to chase up, so the picker stays hidden to keep the common
    // case fast.
    function updateStakeholderVisibility() {
      const discountValue = Number(document.getElementById("discount-input").value) || 0;
      const relevant = paymentMethod === "CREDIT" || discountValue < 0;
      document.getElementById("stakeholder-section").classList.toggle("hidden", !relevant);
      document.getElementById("stakeholder-label").textContent = mode === "sell" ? "Customer" : "Supplier";
    }

    let stakeholders = [];
    async function loadStakeholders() {
      try {
        const res = await fetch("/api/stakeholders/lookup");
        stakeholders = await res.json();
        const select = document.getElementById("stakeholder-input");
        select.innerHTML = '<option value="">— not specified —</option>' +
          stakeholders.map((s) => `<option value="${s.id}">${escapeHtml(s.name)} (${s.category})</option>`).join("");
      } catch (err) {
        console.error("Failed to load stakeholders", err);
      }
    }
    loadStakeholders();

    setPaymentMethod("CASH");

    function setMode(next) {
      mode = next;
      ticket = [];
      renderTicket();
      modeLabel.textContent = mode === "sell" ? "Sale in progress" : "Receiving stock";
      btnPost.textContent = mode === "sell" ? "Complete Sale" : "Record Stock Received";
      modeSellBtn.classList.toggle("bg-till", mode === "sell");
      modeSellBtn.classList.toggle("text-paper", mode === "sell");
      modeSellBtn.classList.toggle("text-ink/60", mode !== "sell");
      modeBuyBtn.classList.toggle("bg-till", mode === "buy");
      modeBuyBtn.classList.toggle("text-paper", mode === "buy");
      modeBuyBtn.classList.toggle("text-ink/60", mode !== "buy");
      document.getElementById("discount-label").textContent = mode === "sell" ? "Discount Given (KES)" : "Discount Received (KES)";
      document.getElementById("discount-input").value = "0";
      renderGrid();
    }
    modeSellBtn.addEventListener("click", () => setMode("sell"));
    modeBuyBtn.addEventListener("click", () => setMode("buy"));

    async function loadProducts() {
      const res = await fetch("/api/products");
      products = await res.json(); // { inventory: [...], services: [...], utilities: [...], investments: [...] }
      renderGrid();
    }

    function renderGrid() {
      grid.innerHTML = "";
      // Utilities and Investments are buy-only at the Till — paying for
      // electricity or acquiring a bond/shares happens here, but selling an
      // investment is a deliberate action handled on the Money >
      // Investments or Assets page instead, never mixed into everyday
      // till activity.
      const utilitiesAndInvestments = mode === "buy" ? products.utilities.length + products.investments.length : 0;
      const totalCount = products.inventory.length + products.services.length + utilitiesAndInvestments;
      if (totalCount === 0) {
        emptyMsg.classList.remove("hidden");
        return;
      }
      emptyMsg.classList.add("hidden");

      renderSection("Inventory", products.inventory, "");
      renderSection("Services", products.services, "Sold to or bought for the business");
      if (mode === "buy") {
        renderSection("Utilities", products.utilities, "Electricity, internet, loan-related — usually an owner or manager action");
        renderSection("Investments", products.investments, "Bonds, shares, and similar instruments — acquiring one here. To sell, use Money → Investments or the Assets page.");
      }
    }

    function renderSection(label, items, hint) {
      if (items.length === 0) return;

      const section = document.createElement("div");

      const heading = document.createElement("div");
      heading.className = "flex items-baseline justify-between mb-3";
      heading.innerHTML = `
        <span class="font-mono text-xs uppercase tracking-widest text-ink/40">${label}</span>
        ${hint ? `<span class="text-xs text-ink/30">${hint}</span>` : ""}
      `;
      section.appendChild(heading);

      const sectionGrid = document.createElement("div");
      sectionGrid.className = "grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4";

      for (const p of items) {
        const tile = document.createElement(p.isInvestment ? "a" : "button");
        if (p.isInvestment) tile.href = "/money/investments";
        tile.className =
          "text-left bg-white rounded-xl border border-ink/10 p-4 hover:border-till hover:shadow-md transition flex flex-col justify-between h-28";
        const stockLine = p.isService || p.isUtility
          ? (p.billingCycle ? p.billingCycle.replace(/_/g, " ").toLowerCase() : "")
          : p.isInvestment
          ? "manage in Investments →"
          : `stock ${p.stock}`;
        tile.innerHTML = `
          <span class="font-display text-base leading-tight">${escapeHtml(p.name || "Unnamed")}</span>
          <div class="flex justify-between items-end mt-2">
            <span class="font-mono text-xs text-ink/40">${stockLine}</span>
            <span class="font-mono text-lg tabular-nums text-till">${fmtNum(p.price)}</span>
          </div>
        `;
        if (!p.isInvestment) tile.addEventListener("click", () => addToTicket(p));
        sectionGrid.appendChild(tile);
      }
      section.appendChild(sectionGrid);
      grid.appendChild(section);
    }

    function addToTicket(product) {
      const existing = ticket.find((l) => l.id === product.id);
      if (existing) {
        existing.qty += 1;
      } else {
        ticket.push({
          id: product.id,
          name: product.name,
          price: mode === "sell" ? product.price : product.cost || product.price,
          qty: 1,
        });
      }
      renderTicket();
    }

    function renderTicket() {
      ticketLines.innerHTML = "";
      if (ticket.length === 0) {
        ticketLines.innerHTML = `<p class="text-ink/30 italic">Tap a product to add it.</p>`;
        btnPost.disabled = true;
        ticketTotal.textContent = "0.00";
        updateNetTotal(0);
        return;
      }
      let total = 0;
      for (const line of ticket) {
        const lineTotal = line.qty * line.price;
        total += lineTotal;
        const row = document.createElement("div");
        row.className = "flex justify-between items-center";
        row.innerHTML = `
          <span>${escapeHtml(line.name)} <span class="text-ink/40">x${line.qty}</span></span>
          <span class="tabular-nums">${fmtNum(lineTotal)}</span>
        `;
        ticketLines.appendChild(row);
      }
      ticketTotal.textContent = fmtNum(total);
      btnPost.disabled = false;
      updateNetTotal(total);
    }

    function updateNetTotal(listTotal) {
      const discountInput = document.getElementById("discount-input");
      let discount = Number(discountInput.value) || 0;
      // Clamp magnitude to the basket total either direction — can't
      // discount or credit more than the sale is worth.
      if (Math.abs(discount) > listTotal) {
        discount = discount < 0 ? -listTotal : listTotal;
      }
      const collectedNow = discount < 0 ? listTotal - Math.abs(discount) : listTotal - discount;
      const netLabel = document.getElementById("ticket-net-total-label");
      if (netLabel) netLabel.textContent = discount < 0 ? "Collected Now" : "Net Total";
      document.getElementById("ticket-net-total").textContent = fmtNum(collectedNow);
    }

    document.getElementById("discount-input").addEventListener("input", () => {
      const total = ticket.reduce((sum, line) => sum + line.qty * line.price, 0);
      updateNetTotal(total);
      updateStakeholderVisibility();
    });

    btnClear.addEventListener("click", () => {
      ticket = [];
      renderTicket();
      hideFeedback();
    });

    btnPost.addEventListener("click", async () => {
      btnPost.disabled = true;
      btnPost.textContent = "Posting...";
      const discountValue = Number(document.getElementById("discount-input").value) || 0;
      try {
        const res = await fetch("/api/basket", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            mode,
            paymentMethod,
            discount: discountValue,
            stakeholderId: document.getElementById("stakeholder-input").value || null,
            paymentReference: document.getElementById("mobile-reference-input").value,
            notes: document.getElementById("notes-input")?.value || "",
            lines: ticket.map((l) => ({
              productId: l.id,
              quantity: l.qty,
              unitPrice: l.price,
            })),
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Posting failed");
        const discountNote = data.discount > 0
          ? ` (discount ${fmtNum(data.discount)}, net ${fmtNum(data.netTotal)})`
          : data.creditSplit > 0
          ? ` (${fmtNum(data.creditSplit)} on credit, ${fmtNum(data.netTotal)} collected now)`
          : "";
        showFeedback(`Posted ${data.cycleReference} — total ${fmtNum(data.total)}${discountNote}`, true);
        ticket = [];
        document.getElementById("discount-input").value = "0";
        document.getElementById("stakeholder-input").value = "";
        document.getElementById("mobile-reference-input").value = "";
        const notesInputReset = document.getElementById("notes-input");
        if (notesInputReset) notesInputReset.value = "";
        updateStakeholderVisibility();
        renderTicket();
        loadProducts(); // refresh stock counts
        loadDenomCount(); // refresh expected cash so the variance stays current
      } catch (err) {
        showFeedback(err.message, false);
      } finally {
        btnPost.textContent = mode === "sell" ? "Complete Sale" : "Record Stock Received";
      }
    });

    function showFeedback(msg, ok) {
      feedback.textContent = msg;
      feedback.className = `p-4 text-sm ${ok ? "bg-till/10 text-till" : "bg-clay/10 text-clay"}`;
      feedback.classList.remove("hidden");
      setTimeout(hideFeedback, 4000);
    }
    function hideFeedback() {
      feedback.classList.add("hidden");
    }

    function escapeHtml(str) {
      const div = document.createElement("div");
      div.textContent = str ?? "";
      return div.innerHTML;
    }

    setMode("sell");
    loadProducts();
  </script>

  <!-- Denomination Tracker -->
  <div id="denom-bar" class="fixed bottom-0 left-0 right-0 bg-white border-t-2 border-ink/10 z-40 transition-transform">
    <button type="button" onclick="toggleDenomBar()" class="w-full px-6 py-2 flex items-center justify-between text-xs font-mono uppercase tracking-widest text-ink/50 hover:text-ink transition">
      <span>Till Count <span id="denom-variance-badge" class="hidden ml-2 px-2 py-0.5 rounded-full text-xs normal-case tracking-normal"></span></span>
      <span id="denom-toggle-icon">▲</span>
    </button>
    <div id="denom-body" class="hidden px-6 pb-4 border-t border-ink/5 pt-4">
      <div class="flex items-end justify-between mb-3 flex-wrap gap-2">
        <div>
          <p class="text-xs text-ink/50">Counted: <span id="denom-counted" class="font-mono font-medium text-ink">0.00</span> · Expected (Cash account): <span id="denom-expected" class="font-mono font-medium text-ink">0.00</span></p>
          <p id="denom-variance-text" class="text-xs mt-0.5"></p>
        </div>
        <button type="button" id="denom-save-btn" onclick="saveDenomCount()" class="px-4 py-2 rounded-lg bg-till text-paper text-sm font-display hover:brightness-110 transition">Save Count</button>
      </div>
      <div id="denom-grid" class="grid grid-cols-5 md:grid-cols-10 gap-2"></div>
    </div>
  </div>

  <script>
    const DENOMS = [1000, 500, 200, 100, 50, 40, 20, 10, 5, 1];
    let denomBarOpen = false;

    function toggleDenomBar() {
      denomBarOpen = !denomBarOpen;
      document.getElementById("denom-body").classList.toggle("hidden", !denomBarOpen);
      document.getElementById("denom-toggle-icon").textContent = denomBarOpen ? "▼" : "▲";
    }

    function buildDenomGrid(counts) {
      const grid = document.getElementById("denom-grid");
      grid.innerHTML = DENOMS.map((d) => `
        <div>
          <label class="block text-xs font-mono text-ink/40 mb-1 text-center">KES ${d}</label>
          <input type="number" min="0" step="1" value="${counts[d] || 0}" data-denom="${d}"
            oninput="updateDenomTotal()"
            class="denom-input w-full border border-ink/20 rounded-lg px-2 py-1.5 text-center font-mono text-sm" />
        </div>
      `).join("");
    }

    function updateDenomTotal() {
      let total = 0;
      document.querySelectorAll(".denom-input").forEach((input) => {
        total += Number(input.dataset.denom) * (Number(input.value) || 0);
      });
      document.getElementById("denom-counted").textContent = fmtNum(total);
      renderDenomVariance(total, lastExpectedCash);
    }

    let lastExpectedCash = 0;

    function renderDenomVariance(counted, expected) {
      const variance = Math.round((counted - expected) * 100) / 100;
      const varianceText = document.getElementById("denom-variance-text");
      const badge = document.getElementById("denom-variance-badge");
      if (variance === 0) {
        varianceText.textContent = "Reconciled — counted matches the Cash account.";
        varianceText.className = "text-xs mt-0.5 text-till";
        badge.classList.add("hidden");
      } else {
        const over = variance > 0;
        varianceText.textContent = `${over ? "Over" : "Short"} by KES ${fmtNum(Math.abs(variance))} — recount or check for an unrecorded transaction.`;
        varianceText.className = "text-xs mt-0.5 text-clay";
        badge.textContent = over ? `+${fmtNum(variance)}` : fmtNum(variance);
        badge.className = "ml-2 px-2 py-0.5 rounded-full text-xs normal-case tracking-normal bg-clay/10 text-clay";
        badge.classList.remove("hidden");
      }
    }

    async function loadDenomCount() {
      try {
        const res = await fetch("/api/till-denomination");
        const data = await res.json();
        lastExpectedCash = data.expectedCash;
        buildDenomGrid(data.counts);
        document.getElementById("denom-counted").textContent = fmtNum(data.countedTotal);
        document.getElementById("denom-expected").textContent = fmtNum(data.expectedCash);
        renderDenomVariance(data.countedTotal, data.expectedCash);
      } catch (err) {
        console.error("Failed to load till count", err);
      }
    }

    async function saveDenomCount() {
      const btn = document.getElementById("denom-save-btn");
      btn.disabled = true;
      btn.textContent = "Saving...";
      const counts = {};
      document.querySelectorAll(".denom-input").forEach((input) => {
        counts[input.dataset.denom] = Number(input.value) || 0;
      });
      try {
        const res = await fetch("/api/till-denomination", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ counts }),
        });
        const result = await res.json();
        if (!res.ok) throw new Error(result.error || "Failed to save count");
        lastExpectedCash = result.expectedCash;
        document.getElementById("denom-expected").textContent = fmtNum(result.expectedCash);
        renderDenomVariance(result.countedTotal, result.expectedCash);
      } catch (err) {
        alert(err.message);
      } finally {
        btn.disabled = false;
        btn.textContent = "Save Count";
      }
    }

    loadDenomCount();
  </script>
</body>
</html>
