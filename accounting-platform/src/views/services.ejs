<header class="mb-8">
  <a href="/resources" class="text-ink/40 hover:text-till text-sm">← Resources</a>
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mt-2">Resources — <%= currentBusinessUnit %></p>
  <h1 class="font-display text-3xl mt-1">Services</h1>
  <p class="text-ink/50 text-sm mt-1">What the business offers to customers, or engages from others.</p>
</header>

<div class="bg-white rounded-xl border border-ink/10 overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
        <th class="px-5 py-3">Service</th>
        <th class="px-5 py-3 text-right">Price / Charge</th>
        <th class="px-5 py-3 text-right">Cost to Business</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(function(s) { %>
        <tr class="border-b border-ink/5 last:border-0 hover:bg-paper/50">
          <td class="px-5 py-3 font-display"><%= s.name %></td>
          <td class="px-5 py-3 text-right font-mono tabular-nums"><%= s.price.toFixed(2) %></td>
          <td class="px-5 py-3 text-right font-mono tabular-nums text-ink/50"><%= s.cost.toFixed(2) %></td>
        </tr>
      <% }) %>
      <% if (items.length === 0) { %>
        <tr><td colspan="3" class="px-5 py-8 text-center text-ink/40">No services set up for <%= currentBusinessUnit %> yet. Add one from Products.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
