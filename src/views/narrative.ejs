<header class="mb-8">
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Insights</p>
  <h1 class="font-display text-3xl mt-1">Narrative</h1>
  <p class="text-ink/50 text-sm mt-1">Plain-language explanations of what happened — generated automatically as the business trades.</p>
</header>

<div class="bg-white rounded-xl border border-ink/10 overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
        <th class="px-5 py-3">Date</th>
        <th class="px-5 py-3">Source</th>
        <th class="px-5 py-3">Story</th>
        <th class="px-5 py-3">Document</th>
      </tr>
    </thead>
    <tbody>
      <% entries.forEach(function(n) { %>
        <tr class="border-b border-ink/5 last:border-0 hover:bg-paper/50">
          <td class="px-5 py-3 font-mono text-xs text-ink/50 whitespace-nowrap"><%= n.date %></td>
          <td class="px-5 py-3">
            <span class="text-xs font-mono px-2 py-0.5 rounded-full <%= n.isGenerated ? 'bg-paper text-ink/50' : 'bg-till/10 text-till' %>"><%= n.source %></span>
          </td>
          <td class="px-5 py-3 text-ink/70"><%= n.description %></td>
          <td class="px-5 py-3">
            <% if (n.receiptNo) { %>
              <a href="/documents/receipt/<%= n.recordsId %>" class="text-xs font-mono text-till hover:underline"><%= n.receiptNo %></a>
            <% } else if (n.transactionId) { %>
              <a href="/transactions?highlight=<%= n.transactionId %>" class="text-xs font-mono text-ink/40 hover:text-till hover:underline">TXN #<%= n.transactionId %></a>
            <% } else { %>
              <span class="text-xs text-ink/20">—</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (entries.length === 0) { %>
        <tr><td colspan="4" class="px-5 py-8 text-center text-ink/40">No narrative entries yet — they're generated automatically as you post sales, expenses, and purchases.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
