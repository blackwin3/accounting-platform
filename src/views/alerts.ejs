<header class="mb-8">
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Monitoring</p>
  <h1 class="font-display text-3xl mt-1">Alerts</h1>
</header>

<% if (alerts.length === 0) { %>
  <div class="bg-white rounded-xl border border-ink/10 p-8 text-center">
    <p class="font-display text-lg text-till">All clear</p>
    <p class="text-ink/50 text-sm mt-1">No alerts right now.</p>
  </div>
<% } else { %>
  <div class="space-y-3">
    <% alerts.forEach(function(a) { %>
      <a href="<%= a.link %>" class="block bg-white rounded-xl border p-4 hover:shadow-md transition <%= a.severity === 'high' ? 'border-clay/30' : 'border-ink/10' %>">
        <div class="flex items-start gap-3">
          <span class="mt-0.5 w-2 h-2 rounded-full flex-shrink-0 <%= a.severity === 'high' ? 'bg-clay' : 'bg-till' %>"></span>
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-ink/40"><%= a.type.replace(/_/g, ' ') %></p>
            <p class="mt-1"><%= a.message %></p>
          </div>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>
