<header class="mb-8">
  <a href="/claims" class="text-ink/40 hover:text-till text-sm">← Claims</a>
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mt-2">Claims — <%= currentBusinessUnit %></p>
  <h1 class="font-display text-3xl mt-1">Leases &amp; Provisions</h1>
  <p class="text-ink/50 text-sm mt-1">Right-of-Use leases (IFRS 16) and estimated obligations like warranties (IAS 37).</p>
</header>

<div class="grid md:grid-cols-2 gap-6 mb-8">
  <section class="bg-white rounded-xl border border-ink/10 p-6">
    <h2 class="font-display text-xl mb-1">Commence a Lease</h2>
    <p class="text-ink/50 text-sm mb-5">Recognises a Right-of-Use asset and Lease Liability together, at the total contracted payments over the term.</p>
    <form id="lease-form" class="space-y-4">
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Description</label>
        <input name="description" type="text" required placeholder="e.g. Shop premises, Naivasha" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display" />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Total Payments (KES)</label>
          <input name="totalLeasePayments" type="number" min="0.01" step="0.01" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Term (years)</label>
          <input name="leaseTermYears" type="number" min="1" step="1" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        </div>
      </div>
      <button type="submit" id="lease-submit" class="w-full py-3 rounded-lg bg-till text-paper font-display text-lg hover:brightness-110 transition">Commence Lease</button>
      <div id="lease-feedback" class="hidden text-sm p-3 rounded-lg"></div>
    </form>
  </section>

  <section class="bg-white rounded-xl border border-ink/10 p-6">
    <h2 class="font-display text-xl mb-1">Make a Lease Payment</h2>
    <p class="text-ink/50 text-sm mb-5">Reduces the Lease Liability. The Right-of-Use asset amortises separately, on the Assets page.</p>
    <% if (leases.length === 0) { %>
      <p class="text-ink/40 text-sm">No active leases yet.</p>
    <% } else { %>
      <form id="lease-payment-form" class="space-y-4">
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Lease</label>
          <select name="liabilityId" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
            <% leases.forEach(function(l) { %>
              <option value="<%= l.id %>"><%= l.description %> — outstanding <%= l.amount.toFixed(2) %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Amount (KES)</label>
          <input name="amount" type="number" min="0.01" step="0.01" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Payment Method</label>
          <div class="grid grid-cols-3 gap-1.5">
            <label><input type="radio" name="paymentMethod" value="CASH" checked class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Cash</div></label>
            <label><input type="radio" name="paymentMethod" value="MOBILE" class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Mobile</div></label>
            <label><input type="radio" name="paymentMethod" value="BANK" class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Bank</div></label>
          </div>
        </div>
        <button type="submit" id="lease-payment-submit" class="w-full py-3 rounded-lg bg-till text-paper font-display text-lg hover:brightness-110 transition">Make Payment</button>
        <div id="lease-payment-feedback" class="hidden text-sm p-3 rounded-lg"></div>
      </form>
    <% } %>
  </section>
</div>

<div class="grid md:grid-cols-2 gap-6">
  <section class="bg-white rounded-xl border border-ink/10 p-6">
    <h2 class="font-display text-xl mb-1">Record a Provision</h2>
    <p class="text-ink/50 text-sm mb-5">Set money aside for something you expect to pay later — vet costs, warranty claims, annual government charges. The cost appears now, the payment happens when it's due.</p>
    <form id="provision-form" class="space-y-4">
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Amount (KES)</label>
        <input name="amount" type="number" min="0.01" step="0.01" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Description</label>
        <textarea name="description" rows="2" placeholder="e.g. Provision for vet costs, county land rates, warranty on goods sold" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display"></textarea>
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Date (leave blank for today)</label>
        <input name="provisionDate" type="date" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" onchange="
          if (this.value && new Date(this.value) < new Date(new Date().toISOString().slice(0,10))) {
            document.getElementById('backdate-warn').classList.remove('hidden');
          } else {
            document.getElementById('backdate-warn').classList.add('hidden');
          }
        " />
        <div id="backdate-warn" class="hidden bg-amber-50 border border-amber-200 rounded-lg px-3 py-2 text-xs text-amber-700 mt-1">
          ⚠ You are backdating this provision. The accountant will need to verify why this obligation wasn't recorded when it first arose. Add a clear note below explaining the reason.
        </div>
      </div>
      <button type="submit" id="provision-submit" class="w-full py-3 rounded-lg bg-clay text-paper font-display text-lg hover:brightness-110 transition">Record Provision</button>
      <div id="provision-feedback" class="hidden text-sm p-3 rounded-lg"></div>
    </form>
  </section>

  <section class="bg-white rounded-xl border border-ink/10 p-6">
    <h2 class="font-display text-xl mb-1">Honour a Claim</h2>
    <p class="text-ink/50 text-sm mb-5">Draws down an existing provision — no new expense, since it was already recognised.</p>
    <% if (provisions.length === 0) { %>
      <p class="text-ink/40 text-sm">No open provisions yet.</p>
    <% } else { %>
      <form id="provision-utilise-form" class="space-y-4">
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Provision</label>
          <select name="liabilityId" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
            <% provisions.forEach(function(p) { %>
              <option value="<%= p.id %>">Remaining <%= p.amount.toFixed(2) %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Claim Amount (KES)</label>
          <input name="amount" type="number" min="0.01" step="0.01" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Payment Method</label>
          <div class="grid grid-cols-3 gap-1.5">
            <label><input type="radio" name="paymentMethod" value="CASH" checked class="peer sr-only" /><div class="peer-checked:bg-clay peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Cash</div></label>
            <label><input type="radio" name="paymentMethod" value="MOBILE" class="peer sr-only" /><div class="peer-checked:bg-clay peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Mobile</div></label>
            <label><input type="radio" name="paymentMethod" value="BANK" class="peer sr-only" /><div class="peer-checked:bg-clay peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Bank</div></label>
          </div>
        </div>
        <button type="submit" id="provision-utilise-submit" class="w-full py-3 rounded-lg bg-clay text-paper font-display text-lg hover:brightness-110 transition">Honour Claim</button>
        <div id="provision-utilise-feedback" class="hidden text-sm p-3 rounded-lg"></div>
      </form>
    <% } %>
  </section>
</div>

<script>
  function wireForm(formId, feedbackId, submitId, url, buildBody, successMessage, resetOnSuccess) {
    const form = document.getElementById(formId);
    if (!form) return;
    const feedback = document.getElementById(feedbackId);
    const submitBtn = document.getElementById(submitId);
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = "Posting...";
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(buildBody(data)),
        });
        const result = await res.json();
        if (!res.ok) throw new Error(result.error || "Failed to post");
        feedback.textContent = successMessage(result, data);
        feedback.className = "text-sm p-3 rounded-lg bg-till/10 text-till";
        feedback.classList.remove("hidden");
        if (resetOnSuccess) setTimeout(() => location.reload(), 900);
      } catch (err) {
        feedback.textContent = err.message;
        feedback.className = "text-sm p-3 rounded-lg bg-clay/10 text-clay";
        feedback.classList.remove("hidden");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  }

  wireForm("lease-form", "lease-feedback", "lease-submit", "/api/lease-commencement",
    (data) => ({ description: data.description, totalLeasePayments: Number(data.totalLeasePayments), leaseTermYears: Number(data.leaseTermYears) }),
    () => "Lease commenced.", true);

  wireForm("lease-payment-form", "lease-payment-feedback", "lease-payment-submit", "/api/lease-payment",
    (data) => ({ liabilityId: Number(data.liabilityId), amount: Number(data.amount), paymentMethod: data.paymentMethod }),
    (result) => `Payment recorded — remaining liability KES ${result.newOutstanding.toFixed(2)}.`, true);

  wireForm("provision-form", "provision-feedback", "provision-submit", "/api/provision",
    (data) => ({ amount: Number(data.amount), description: data.description }),
    () => "Provision recorded.", true);

  wireForm("provision-utilise-form", "provision-utilise-feedback", "provision-utilise-submit", "/api/provision-utilisation",
    (data) => ({ liabilityId: Number(data.liabilityId), amount: Number(data.amount), paymentMethod: data.paymentMethod }),
    (result) => `Claim honoured — remaining provision KES ${result.newOutstanding.toFixed(2)}.`, true);
</script>
