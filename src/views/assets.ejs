<header class="mb-8">
  <a href="/resources" class="text-ink/40 hover:text-till text-sm">← Resources</a>
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mt-2">Resources — <%= currentBusinessUnit %></p>
  <h1 class="font-display text-3xl mt-1">Assets</h1>
  <p class="text-ink/50 text-sm mt-1">Vehicles, equipment, and property used over several years and depreciated — not stock for resale.</p>
</header>

<section class="bg-white rounded-xl border border-ink/10 p-6 mb-8">
  <h2 class="font-display text-xl mb-1">Asset Register Summary</h2>
  <p class="text-ink/50 text-sm mb-5">Whole-business totals, genuinely computed from the register each time — not scoped to <%= currentBusinessUnit %> alone the way the wizard and table below are.</p>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-ink/40"><%= assetsSummary.assetCount %> Active Assets</p>
      <p class="font-display text-xl"><%= fmt(assetsSummary.totalCost) %></p>
      <p class="text-xs text-ink/40">Total cost</p>
    </div>
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Accumulated Depreciation</p>
      <p class="font-display text-xl"><%= fmt(assetsSummary.totalAccumulatedDepreciation) %></p>
    </div>
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Accumulated Impairment</p>
      <p class="font-display text-xl"><%= fmt(assetsSummary.totalAccumulatedImpairment) %></p>
    </div>
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Total Carrying Value</p>
      <p class="font-display text-xl text-till"><%= fmt(assetsSummary.totalCarryingValue) %></p>
    </div>
  </div>

  <% if (depreciationSchedule.length > 0) { %>
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Depreciation Schedule</p>
    <div class="space-y-2 mb-6">
      <% depreciationSchedule.forEach(function(d) { %>
        <div class="flex items-center justify-between text-sm border-b border-ink/5 pb-2">
          <span class="font-display"><%= d.type %></span>
          <span class="text-ink/50 text-xs"><%= fmt(d.annualCharge) %>/yr · <%= d.percentDepreciated %>% depreciated</span>
        </div>
      <% }) %>
    </div>
  <% } %>

  <% if (disposalHistory.length > 0) { %>
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Recent Disposals</p>
    <div class="space-y-2">
      <% disposalHistory.forEach(function(d) { %>
        <div class="flex items-center justify-between text-sm border-b border-ink/5 pb-2">
          <span class="font-display"><%= d.type %></span>
          <span class="text-ink/50 text-xs">Cost <%= fmt(d.cost) %> · <%= d.disposalDate ? new Date(d.disposalDate).toLocaleDateString('en-GB') : '—' %></span>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<div class="grid md:grid-cols-2 gap-6 mb-8">
  <section class="bg-white rounded-xl border border-ink/10 p-6">
    <h2 class="font-display text-xl mb-1">Buy an Asset</h2>
    <p class="text-ink/50 text-sm mb-5">Posts DR Property Plant and Equipment / CR your chosen payment method and opens a depreciation schedule.</p>

    <form id="asset-form" class="space-y-5">
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Asset name</label>
        <input name="name" type="text" required placeholder="e.g. Toyota Vitz" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display" />
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Cost (KES)</label>
        <input name="cost" type="number" min="0.01" step="0.01" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Useful life (years)</label>
          <input name="usefulLifeYears" type="number" min="1" step="1" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Residual value (KES)</label>
          <input name="residualValue" type="number" min="0" step="0.01" value="0" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        </div>
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Valuation Method</label>
        <select name="depreciationMethod" id="valuation-method-select" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono">
          <option value="STRAIGHT_LINE">Straight-line depreciation</option>
          <option value="REDUCING_BALANCE">Reducing balance depreciation</option>
          <option value="UNITS_OF_PRODUCTION">Units of production depreciation</option>
          <option value="APPRECIATING">Appreciating (e.g. Land) — increases over time, revalued manually</option>
          <option value="MARKET_VALUE">Market-dependent (e.g. Gold, vehicles, jewellery) — value tracks market price, revalued manually</option>
        </select>
        <p id="valuation-method-hint" class="text-xs text-ink/40 mt-1 hidden">This asset won't follow a depreciation schedule — its value is updated periodically using Revalue on the register below instead.</p>
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Ownership</label>
        <select name="ownershipType" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono">
          <option value="BUSINESS">Business — owned outright by the business</option>
          <option value="PERSONAL">Personal — owner's property, also used for the business</option>
          <option value="JOINT">Joint — owned by more than one family member</option>
          <option value="FAMILY">Family — owned by the family as a whole (e.g. ancestral land)</option>
        </select>
        <p class="text-xs text-ink/40 mt-1">Anything other than Business should be reviewed with an accountant before relying on it for tax or succession purposes.</p>
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Payment Method</label>
        <div class="grid grid-cols-4 gap-1.5">
          <label><input type="radio" name="paymentMethod" value="CASH" checked class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Cash</div></label>
          <label><input type="radio" name="paymentMethod" value="MOBILE" class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Mobile</div></label>
          <label><input type="radio" name="paymentMethod" value="BANK" class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Bank</div></label>
          <label><input type="radio" name="paymentMethod" value="CREDIT" class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Credit</div></label>
        </div>
      </div>

      <button type="submit" id="submit-btn" class="w-full py-3 rounded-lg bg-till text-paper font-display text-lg hover:brightness-110 transition">
        Record Purchase
      </button>
      <div id="feedback" class="hidden text-sm p-3 rounded-lg"></div>
    </form>
  </section>

  <section class="bg-white rounded-xl border border-ink/10 p-6">
    <h2 class="font-display text-xl mb-1">Dispose of an Asset</h2>
    <p class="text-ink/50 text-sm mb-5">Removes the asset from the register and recognises any gain or loss on sale.</p>

    <% if (activeAssets.length === 0) { %>
      <p class="text-ink/40 text-sm">No active assets to dispose of.</p>
    <% } else { %>
      <form id="disposal-form" class="space-y-5">
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Asset</label>
          <select name="assetId" required id="disposal-asset-select" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
            <% activeAssets.forEach(function(a) { %>
              <option value="<%= a.id %>" data-carrying="<%= a.carryingAmount %>"><%= a.name %> (carrying amount <%= a.carryingAmount.toFixed(2) %>)</option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Sale proceeds (KES)</label>
          <input name="proceeds" type="number" min="0" step="0.01" value="0" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
          <p class="text-xs text-ink/40 mt-1">Enter 0 for a write-off or scrap with no sale.</p>
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Payment Method</label>
          <div class="grid grid-cols-4 gap-1.5">
            <label><input type="radio" name="paymentMethod" value="CASH" checked class="peer sr-only" /><div class="peer-checked:bg-clay peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Cash</div></label>
            <label><input type="radio" name="paymentMethod" value="MOBILE" class="peer sr-only" /><div class="peer-checked:bg-clay peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Mobile</div></label>
            <label><input type="radio" name="paymentMethod" value="BANK" class="peer sr-only" /><div class="peer-checked:bg-clay peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Bank</div></label>
            <label><input type="radio" name="paymentMethod" value="CREDIT" class="peer sr-only" /><div class="peer-checked:bg-clay peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Credit</div></label>
          </div>
        </div>
        <button type="submit" id="disposal-submit" class="w-full py-3 rounded-lg bg-clay text-paper font-display text-lg hover:brightness-110 transition">
          Dispose of Asset
        </button>
        <div id="disposal-feedback" class="hidden text-sm p-3 rounded-lg"></div>
      </form>
    <% } %>
  </section>
</div>

<div class="grid md:grid-cols-2 gap-6 mb-8">
  <section class="bg-white rounded-xl border border-ink/10 p-6">
    <h2 class="font-display text-xl mb-1">Post Depreciation</h2>
    <p class="text-ink/50 text-sm mb-5">Charges one period of depreciation (DR Depreciation Expense, CR Accumulated Depreciation). Leave the amount blank for the standard one-month straight-line charge.</p>
    <% if (activeAssets.length === 0) { %>
      <p class="text-ink/40 text-sm">No active assets to depreciate.</p>
    <% } else { %>
      <form id="depreciation-form" class="space-y-5">
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Asset</label>
          <select name="assetId" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
            <% activeAssets.forEach(function(a) { %>
              <option value="<%= a.id %>"><%= a.name %> (carrying amount <%= a.carryingAmount.toFixed(2) %>)</option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Amount (KES) — optional</label>
          <input name="amount" type="number" min="0.01" step="0.01" placeholder="Leave blank for standard monthly charge" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        </div>
        <button type="submit" id="depreciation-submit" class="w-full py-3 rounded-lg bg-till text-paper font-display text-lg hover:brightness-110 transition">
          Post Depreciation
        </button>
        <div id="depreciation-feedback" class="hidden text-sm p-3 rounded-lg"></div>
      </form>
    <% } %>
  </section>

  <section class="bg-white rounded-xl border border-ink/10 p-6">
    <h2 class="font-display text-xl mb-1">Record Impairment</h2>
    <p class="text-ink/50 text-sm mb-5">A write-down from damage, obsolescence, or a drop in value — the asset stays in the register, this is not a disposal.</p>
    <% if (activeAssets.length === 0) { %>
      <p class="text-ink/40 text-sm">No active assets to impair.</p>
    <% } else { %>
      <form id="impairment-form" class="space-y-5">
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Asset</label>
          <select name="assetId" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
            <% activeAssets.forEach(function(a) { %>
              <option value="<%= a.id %>"><%= a.name %> (carrying amount <%= a.carryingAmount.toFixed(2) %>)</option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Write-down amount (KES)</label>
          <input name="writeDownAmount" type="number" min="0.01" step="0.01" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Reason</label>
          <textarea name="reason" rows="2" placeholder="e.g. water damage, superseded by newer equipment" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display"></textarea>
        </div>
        <button type="submit" id="impairment-submit" class="w-full py-3 rounded-lg bg-clay text-paper font-display text-lg hover:brightness-110 transition">
          Record Impairment
        </button>
        <div id="impairment-feedback" class="hidden text-sm p-3 rounded-lg"></div>
      </form>
    <% } %>
  </section>
</div>

<%
  const revaluableAssets = activeAssets.filter(function(a) { return a.method === 'APPRECIATING' || a.method === 'MARKET_VALUE'; });
%>
<% if (revaluableAssets.length > 0) { %>
<div class="mb-8">
  <section class="bg-white rounded-xl border border-ink/10 p-6 max-w-lg">
    <h2 class="font-display text-xl mb-1">Revalue</h2>
    <p class="text-ink/50 text-sm mb-5">For assets that appreciate (Land) or track a market price (gold, vehicles, jewellery) rather than depreciate on a schedule. Enter the newly assessed value — the difference posts as a revaluation surplus or loss.</p>
    <form id="revaluation-form" class="space-y-5">
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Asset</label>
        <select name="assetId" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
          <% revaluableAssets.forEach(function(a) { %>
            <option value="<%= a.id %>"><%= a.name %> (current carrying amount <%= a.carryingAmount.toFixed(2) %>)</option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">New Value (KES)</label>
        <input name="newValue" type="number" min="0" step="0.01" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Reason</label>
        <textarea name="reason" rows="2" placeholder="e.g. independent valuation, current gold spot price" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display"></textarea>
      </div>
      <button type="submit" id="revaluation-submit" class="w-full py-3 rounded-lg bg-till text-paper font-display text-lg hover:brightness-110 transition">
        Revalue Asset
      </button>
      <div id="revaluation-feedback" class="hidden text-sm p-3 rounded-lg"></div>
    </form>
  </section>
</div>
<% } %>

<section>
  <div class="flex items-center justify-between mb-4">
    <h2 class="font-display text-xl">Asset Register</h2>
    <div class="inline-flex rounded-full border border-ink/20 overflow-hidden text-xs">
      <button type="button" onclick="filterRegister('all')" data-filter="all" class="register-filter-btn px-3 py-1.5 bg-till text-paper">All</button>
      <button type="button" onclick="filterRegister('active')" data-filter="active" class="register-filter-btn px-3 py-1.5">Active</button>
      <button type="button" onclick="filterRegister('disposed')" data-filter="disposed" class="register-filter-btn px-3 py-1.5">Disposed</button>
    </div>
  </div>
  <div class="bg-white rounded-xl border border-ink/10 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
          <th class="px-5 py-3">Asset</th>
          <th class="px-5 py-3">Ownership</th>
          <th class="px-5 py-3">Method</th>
          <th class="px-5 py-3 text-right">Cost</th>
          <th class="px-5 py-3 text-right">Accum. Depreciation</th>
          <th class="px-5 py-3 text-right">Accum. Impairment</th>
          <th class="px-5 py-3 text-right">Carrying Amount</th>
          <th class="px-5 py-3">Status</th>
        </tr>
      </thead>
      <tbody>
        <% assets.forEach(function(a) { %>
          <tr class="register-row border-b border-ink/5 last:border-0 hover:bg-paper/50 <%= a.disposed ? 'opacity-50' : '' %>" data-status="<%= a.disposed ? 'disposed' : 'active' %>">
            <td class="px-5 py-3 font-display"><%= a.name %></td>
            <td class="px-5 py-3">
              <span class="text-xs font-mono px-2 py-0.5 rounded-full <%= a.ownershipType === 'BUSINESS' ? 'bg-till/10 text-till' : 'bg-clay/10 text-clay' %>"><%= a.ownershipType %></span>
            </td>
            <td class="px-5 py-3 text-ink/50 text-xs"><%= (a.method || '').replace(/_/g, ' ') %></td>
            <td class="px-5 py-3 text-right font-mono tabular-nums"><%= a.cost.toFixed(2) %></td>
            <td class="px-5 py-3 text-right font-mono tabular-nums text-clay"><%= a.accumulatedDepreciation.toFixed(2) %></td>
            <td class="px-5 py-3 text-right font-mono tabular-nums text-clay"><%= (a.accumulatedImpairment || 0).toFixed(2) %></td>
            <td class="px-5 py-3 text-right font-mono tabular-nums text-till"><%= a.carryingAmount.toFixed(2) %></td>
            <td class="px-5 py-3">
              <span class="text-xs font-mono px-2 py-0.5 rounded-full <%= a.disposed ? 'bg-ink/10 text-ink/50' : 'bg-till/10 text-till' %>"><%= a.disposed ? 'Disposed' : 'Active' %></span>
            </td>
          </tr>
        <% }) %>
        <% if (assets.length === 0) { %>
          <tr><td colspan="8" class="px-5 py-8 text-center text-ink/40">No assets recorded for <%= currentBusinessUnit %> yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<script>
  function filterRegister(filter) {
    document.querySelectorAll(".register-filter-btn").forEach((btn) => {
      const active = btn.dataset.filter === filter;
      btn.classList.toggle("bg-till", active);
      btn.classList.toggle("text-paper", active);
    });
    document.querySelectorAll(".register-row").forEach((row) => {
      const show = filter === "all" || row.dataset.status === filter;
      row.classList.toggle("hidden", !show);
    });
  }
</script>

<script>
  // --- Purchase form ---
  const form = document.getElementById("asset-form");
  const feedback = document.getElementById("feedback");
  const submitBtn = document.getElementById("submit-btn");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = "Posting...";
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch("/api/asset-purchase", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: data.name,
          cost: Number(data.cost),
          usefulLifeYears: Number(data.usefulLifeYears),
          residualValue: Number(data.residualValue || 0),
          depreciationMethod: data.depreciationMethod,
          ownershipType: data.ownershipType,
          paymentMethod: data.paymentMethod,
        }),
      });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to record asset purchase");
      feedback.textContent = `Recorded: ${data.name} — monthly depreciation KES ${result.monthlyDepreciation.toFixed(2)}.`;
      feedback.className = "text-sm p-3 rounded-lg bg-till/10 text-till";
      feedback.classList.remove("hidden");
      form.reset();
      setTimeout(() => location.reload(), 800);
    } catch (err) {
      feedback.textContent = err.message;
      feedback.className = "text-sm p-3 rounded-lg bg-clay/10 text-clay";
      feedback.classList.remove("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = "Record Purchase";
    }
  });

  // --- Disposal form ---
  const disposalForm = document.getElementById("disposal-form");
  if (disposalForm) {
    const disposalFeedback = document.getElementById("disposal-feedback");
    const disposalSubmit = document.getElementById("disposal-submit");

    disposalForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      disposalSubmit.disabled = true;
      disposalSubmit.textContent = "Posting...";
      const data = Object.fromEntries(new FormData(disposalForm).entries());
      try {
        const res = await fetch("/api/asset-disposal", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            assetId: Number(data.assetId),
            proceeds: Number(data.proceeds || 0),
            paymentMethod: data.paymentMethod,
          }),
        });
        const result = await res.json();
        if (!res.ok) throw new Error(result.error || "Failed to record disposal");
        const gl = result.gainLoss;
        disposalFeedback.textContent = gl === 0
          ? "Disposed — no gain or loss."
          : `Disposed — ${gl > 0 ? "gain" : "loss"} of KES ${Math.abs(gl).toFixed(2)}.`;
        disposalFeedback.className = "text-sm p-3 rounded-lg bg-till/10 text-till";
        disposalFeedback.classList.remove("hidden");
        setTimeout(() => location.reload(), 900);
      } catch (err) {
        disposalFeedback.textContent = err.message;
        disposalFeedback.className = "text-sm p-3 rounded-lg bg-clay/10 text-clay";
        disposalFeedback.classList.remove("hidden");
        disposalSubmit.disabled = false;
        disposalSubmit.textContent = "Dispose of Asset";
      }
    });
  }

  // --- Depreciation form ---
  const depreciationForm = document.getElementById("depreciation-form");
  if (depreciationForm) {
    const depreciationFeedback = document.getElementById("depreciation-feedback");
    const depreciationSubmit = document.getElementById("depreciation-submit");

    depreciationForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      depreciationSubmit.disabled = true;
      depreciationSubmit.textContent = "Posting...";
      const data = Object.fromEntries(new FormData(depreciationForm).entries());
      try {
        const res = await fetch("/api/depreciation-run", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            assetId: Number(data.assetId),
            amount: data.amount ? Number(data.amount) : undefined,
          }),
        });
        const result = await res.json();
        if (!res.ok) throw new Error(result.error || "Failed to post depreciation");
        depreciationFeedback.textContent = `Posted KES ${result.amount.toFixed(2)} — new carrying amount KES ${result.newCarrying.toFixed(2)}.`;
        depreciationFeedback.className = "text-sm p-3 rounded-lg bg-till/10 text-till";
        depreciationFeedback.classList.remove("hidden");
        setTimeout(() => location.reload(), 900);
      } catch (err) {
        depreciationFeedback.textContent = err.message;
        depreciationFeedback.className = "text-sm p-3 rounded-lg bg-clay/10 text-clay";
        depreciationFeedback.classList.remove("hidden");
        depreciationSubmit.disabled = false;
        depreciationSubmit.textContent = "Post Depreciation";
      }
    });
  }

  // --- Impairment form ---
  const impairmentForm = document.getElementById("impairment-form");
  if (impairmentForm) {
    const impairmentFeedback = document.getElementById("impairment-feedback");
    const impairmentSubmit = document.getElementById("impairment-submit");

    impairmentForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      impairmentSubmit.disabled = true;
      impairmentSubmit.textContent = "Posting...";
      const data = Object.fromEntries(new FormData(impairmentForm).entries());
      try {
        const res = await fetch("/api/asset-impairment", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            assetId: Number(data.assetId),
            writeDownAmount: Number(data.writeDownAmount),
            reason: data.reason,
          }),
        });
        const result = await res.json();
        if (!res.ok) throw new Error(result.error || "Failed to record impairment");
        impairmentFeedback.textContent = `Recorded — new carrying amount KES ${result.newCarrying.toFixed(2)}.`;
        impairmentFeedback.className = "text-sm p-3 rounded-lg bg-till/10 text-till";
        impairmentFeedback.classList.remove("hidden");
        setTimeout(() => location.reload(), 900);
      } catch (err) {
        impairmentFeedback.textContent = err.message;
        impairmentFeedback.className = "text-sm p-3 rounded-lg bg-clay/10 text-clay";
        impairmentFeedback.classList.remove("hidden");
        impairmentSubmit.disabled = false;
        impairmentSubmit.textContent = "Record Impairment";
      }
    });
  }

  // --- Revaluation form ---
  const revaluationForm = document.getElementById("revaluation-form");
  if (revaluationForm) {
    const revaluationFeedback = document.getElementById("revaluation-feedback");
    const revaluationSubmit = document.getElementById("revaluation-submit");

    revaluationForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      revaluationSubmit.disabled = true;
      revaluationSubmit.textContent = "Posting...";
      const data = Object.fromEntries(new FormData(revaluationForm).entries());
      try {
        const res = await fetch("/api/asset-revaluation", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            assetId: Number(data.assetId),
            newValue: Number(data.newValue),
            reason: data.reason,
          }),
        });
        const result = await res.json();
        if (!res.ok) throw new Error(result.error || "Failed to revalue asset");
        const direction = result.change >= 0 ? "up" : "down";
        revaluationFeedback.textContent = `Revalued ${direction} by KES ${Math.abs(result.change).toFixed(2)} — new carrying amount KES ${result.newCarrying.toFixed(2)}.`;
        revaluationFeedback.className = "text-sm p-3 rounded-lg bg-till/10 text-till";
        revaluationFeedback.classList.remove("hidden");
        setTimeout(() => location.reload(), 900);
      } catch (err) {
        revaluationFeedback.textContent = err.message;
        revaluationFeedback.className = "text-sm p-3 rounded-lg bg-clay/10 text-clay";
        revaluationFeedback.classList.remove("hidden");
        revaluationSubmit.disabled = false;
        revaluationSubmit.textContent = "Revalue Asset";
      }
    });
  }

  // --- Valuation method hint on the purchase form ---
  const valuationMethodSelect = document.getElementById("valuation-method-select");
  if (valuationMethodSelect) {
    const valuationMethodHint = document.getElementById("valuation-method-hint");
    valuationMethodSelect.addEventListener("change", () => {
      const isNonDepreciating = ["APPRECIATING", "MARKET_VALUE"].includes(valuationMethodSelect.value);
      valuationMethodHint.classList.toggle("hidden", !isNonDepreciating);
    });
  }
</script>
