<header class="mb-8">
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Organisation — <%= currentBusinessUnit %></p>
  <h1 class="font-display text-3xl mt-1">Processing</h1>
  <p class="text-ink/50 text-sm mt-1">Convert inventory into a different form — bulk milk into bottles, eggs into trays. Value moves with the stock, not with cash; any spoilage during the process is recorded as a real loss.</p>
</header>

<section class="bg-white rounded-xl border border-ink/10 p-6 mb-10 max-w-2xl">
  <h2 class="font-display text-xl mb-1">New Repackaging</h2>
  <p class="text-ink/50 text-sm mb-5">Add one or more inputs consumed, then the single output produced.</p>

  <form id="repack-form" class="space-y-5">
    <div>
      <div class="flex items-center justify-between mb-2">
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40">Inputs Consumed</label>
        <button type="button" onclick="addInputRow()" class="text-xs text-till hover:underline">+ Add another input</button>
      </div>
      <div id="input-rows" class="space-y-2"></div>
    </div>

    <div class="border-t border-ink/10 pt-5">
      <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Output Produced</label>
      <div class="grid grid-cols-2 gap-3">
        <select id="output-product" required class="border border-ink/20 rounded-lg px-3 py-2 font-display">
          <option value="">Select product…</option>
          <% products.forEach(function(p) { %>
            <option value="<%= p.id %>"><%= p.name %></option>
          <% }) %>
        </select>
        <input id="output-quantity" type="number" min="0.001" step="0.001" required placeholder="Quantity produced" class="border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
    </div>

    <div>
      <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Spoilage / Wastage (optional)</label>
      <input id="spoilage-quantity" type="number" min="0" step="0.001" value="0" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      <p class="text-xs text-ink/40 mt-1">Quantity of the <em>first</em> input above lost during processing — e.g. 1 litre of bulk milk spilled while bottling. Valued at that input's own cost and posted as a real expense.</p>
    </div>

    <div id="repack-preview" class="hidden bg-paper rounded-lg p-4 text-sm"></div>

    <button type="submit" id="repack-submit" class="w-full py-3 rounded-lg bg-till text-paper font-display text-lg hover:brightness-110 transition">Process Repackaging</button>
    <div id="repack-feedback" class="hidden text-sm p-3 rounded-lg"></div>
  </form>
</section>

<section>
  <h2 class="font-display text-xl mb-4">Recent Repackaging</h2>
  <div class="bg-white rounded-xl border border-ink/10 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
          <th class="px-5 py-3">Date</th>
          <th class="px-5 py-3">Details</th>
          <th class="px-5 py-3 text-right">Value</th>
        </tr>
      </thead>
      <tbody>
        <% history.forEach(function(h) { %>
          <tr class="border-b border-ink/5 last:border-0 hover:bg-paper/50">
            <td class="px-5 py-3 font-mono text-xs text-ink/50"><%= h.date %></td>
            <td class="px-5 py-3"><%= h.description %></td>
            <td class="px-5 py-3 text-right font-mono tabular-nums"><%= fmt(h.total) %></td>
          </tr>
        <% }) %>
        <% if (history.length === 0) { %>
          <tr><td colspan="3" class="px-5 py-8 text-center text-ink/40">No repackaging recorded yet for <%= currentBusinessUnit %>.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<script>
  let PRODUCTS = [];
  try { PRODUCTS = 
    JSON.parse('<%- JSON.stringify(products).replace(/\'/g, "\\'") %>'); } 
    catch(e) { console.error('Failed to parse products', e); }

  function fmtNum(n) {
    const num = Number(n || 0);
    const sign = num < 0 ? "-" : "";
    const abs = Math.abs(num);
    const [whole, decimals] = abs.toFixed(2).split(".");
    const withCommas = whole.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    return `${sign}${withCommas}.${decimals}`;
  }

  function productOptions(selectedId) {
    return PRODUCTS.map((p) =>
      `<option value="${p.id}" ${String(p.id) === String(selectedId) ? "selected" : ""}>${p.name} (${p.isStockedGood ? p.stock + " in stock" : "no stock tracked"}, cost ${fmtNum(p.cost)})</option>`
    ).join("");
  }

  let inputRowCount = 0;
  function addInputRow() {
    inputRowCount++;
    const row = document.createElement("div");
    row.className = "grid grid-cols-[1fr_auto_auto] gap-2 input-row";
    row.innerHTML = `
      <select class="input-product border border-ink/20 rounded-lg px-3 py-2 font-display" onchange="updatePreview()">
        <option value="">Select product…</option>
        ${productOptions()}
      </select>
      <input type="number" min="0.001" step="0.001" placeholder="Qty" class="input-quantity w-24 border border-ink/20 rounded-lg px-3 py-2 font-mono" oninput="updatePreview()" />
      <button type="button" onclick="this.closest('.input-row').remove(); updatePreview()" class="px-2 text-clay hover:bg-clay/10 rounded-lg">×</button>
    `;
    document.getElementById("input-rows").appendChild(row);
  }
  addInputRow(); // start with one row

  function updatePreview() {
    const preview = document.getElementById("repack-preview");
    const rows = Array.from(document.querySelectorAll(".input-row"));
    const inputs = rows
      .map((r) => ({
        productId: r.querySelector(".input-product").value,
        quantity: Number(r.querySelector(".input-quantity").value) || 0,
      }))
      .filter((i) => i.productId && i.quantity > 0);

    if (inputs.length === 0) { preview.classList.add("hidden"); return; }

    let totalValue = 0;
    const lines = inputs.map((i) => {
      const p = PRODUCTS.find((pp) => String(pp.id) === String(i.productId));
      const lineValue = (p ? p.cost : 0) * i.quantity;
      totalValue += lineValue;
      return `${i.quantity} × ${p ? p.name : "?"} = KES ${fmtNum(lineValue)}`;
    });

    const spoilageQty = Number(document.getElementById("spoilage-quantity").value) || 0;
    const primaryProduct = PRODUCTS.find((pp) => String(pp.id) === String(inputs[0].productId));
    const spoilageValue = spoilageQty * (primaryProduct ? primaryProduct.cost : 0);
    const outputValue = totalValue - spoilageValue;
    const outputQty = Number(document.getElementById("output-quantity").value) || 0;

    preview.innerHTML = `
      <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Preview</p>
      ${lines.map((l) => `<p class="text-ink/60">${l}</p>`).join("")}
      <p class="text-ink/60 mt-1">Total input value: <span class="font-mono">KES ${fmtNum(totalValue)}</span></p>
      ${spoilageValue > 0 ? `<p class="text-clay">Spoilage: <span class="font-mono">KES ${fmtNum(spoilageValue)}</span></p>` : ""}
      <p class="font-medium mt-1">Output value: <span class="font-mono">KES ${fmtNum(outputValue)}</span>${outputQty > 0 ? ` (unit cost KES ${fmtNum(outputValue / outputQty)})` : ""}</p>
    `;
    preview.classList.remove("hidden");
  }

  document.getElementById("output-quantity").addEventListener("input", updatePreview);
  document.getElementById("spoilage-quantity").addEventListener("input", updatePreview);

  const repackForm = document.getElementById("repack-form");
  const repackFeedback = document.getElementById("repack-feedback");
  const repackSubmit = document.getElementById("repack-submit");

  repackForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const rows = Array.from(document.querySelectorAll(".input-row"));
    const inputs = rows
      .map((r) => ({
        productId: r.querySelector(".input-product").value,
        quantity: Number(r.querySelector(".input-quantity").value) || 0,
      }))
      .filter((i) => i.productId && i.quantity > 0);

    if (inputs.length === 0) {
      alert("Add at least one input product with a quantity.");
      return;
    }

    repackSubmit.disabled = true;
    repackSubmit.textContent = "Processing...";
    try {
      const res = await fetch("/api/repackaging", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          inputs,
          outputProductId: document.getElementById("output-product").value,
          outputQuantity: document.getElementById("output-quantity").value,
          spoilageQuantity: document.getElementById("spoilage-quantity").value,
        }),
      });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to process repackaging");
      repackFeedback.textContent = `Processed. Output unit cost: KES ${fmtNum(result.outputUnitCost)}${result.spoilageValue > 0 ? `, spoilage KES ${fmtNum(result.spoilageValue)}` : ""}.`;
      repackFeedback.className = "text-sm p-3 rounded-lg bg-till/10 text-till";
      repackFeedback.classList.remove("hidden");
      setTimeout(() => location.reload(), 1200);
    } catch (err) {
      repackFeedback.textContent = err.message;
      repackFeedback.className = "text-sm p-3 rounded-lg bg-clay/10 text-clay";
      repackFeedback.classList.remove("hidden");
      repackSubmit.disabled = false;
      repackSubmit.textContent = "Process Repackaging";
    }
  });
</script>
