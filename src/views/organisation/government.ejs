<header class="mb-8">
  <a href="/organisation/business" class="text-ink/40 hover:text-till text-sm">← Organisation</a>
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mt-2">Organisation</p>
  <h1 class="font-display text-3xl mt-1">Government</h1>
  <p class="text-ink/50 text-sm mt-1">Taxes, levies, grants, and government service payments — including rates and land rent that come annually and are easy to forget.</p>
</header>

<section class="bg-white rounded-xl border border-ink/10 p-6 mb-6">
  <h2 class="font-display text-xl mb-1">Tax Summary</h2>
  <p class="text-ink/50 text-sm mb-4">Based on expenses tagged with tax-related categories this period.</p>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-ink/40">VAT Status</p>
      <p class="font-display text-xl"><%= vatRegistered ? 'Registered' : 'Not Registered' %></p>
      <p class="text-xs text-ink/40">Rate: <%= vatRate %>%</p>
    </div>
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Tax Paid (this period)</p>
      <p class="font-display text-xl"><%= fmt(taxPaid) %></p>
    </div>
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Government Grants</p>
      <p class="font-display text-xl"><%= fmt(grantsReceived) %></p>
    </div>
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Provisions for Gov Charges</p>
      <p class="font-display text-xl <%= unprovisionedCharges > 0 ? 'text-clay' : '' %>"><%= fmt(provisionedForGov) %></p>
    </div>
  </div>
</section>

<% if (govExpenses.length > 0) { %>
<section class="bg-white rounded-xl border border-ink/10 overflow-hidden mb-6">
  <div class="px-5 py-3 border-b border-ink/10">
    <h2 class="font-display text-lg">Government Payments</h2>
    <p class="text-xs text-ink/40">Taxes, rates, land rent, licences, and levies — expenses paid to government agencies.</p>
  </div>
  <div class="table-wrap">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
          <th class="px-5 py-2">Description</th>
          <th class="px-5 py-2">Category</th>
          <th class="px-5 py-2 text-right">Amount</th>
          <th class="px-5 py-2">Date</th>
        </tr>
      </thead>
      <tbody>
        <% govExpenses.forEach(function(g) { %>
        <tr class="border-b border-ink/5 last:border-0">
          <td class="px-5 py-3"><%= g.description %></td>
          <td class="px-5 py-3 text-xs text-ink/60"><%= g.category %></td>
          <td class="px-5 py-3 text-right font-mono tabular-nums"><%= fmt(g.amount) %></td>
          <td class="px-5 py-3 text-xs text-ink/60"><%= g.date %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<% } %>

<section class="bg-amber-50 border border-amber-200 rounded-xl p-6 mb-6">
  <h2 class="font-display text-lg text-amber-800 mb-2">Annual Government Charges — Easy to Forget</h2>
  <p class="text-sm text-amber-700 mb-3">Land rates, business permits, county levies, and single business permits are typically paid once a year. If you haven't provisioned for them, they can feel like a surprise when the bill arrives.</p>
  <p class="text-sm text-amber-700"><strong>Recommendation:</strong> Create a provision under Claims → Leases & Provisions for each annual government charge, setting aside 1/12 of the annual amount each month. When the bill arrives, utilise the provision rather than recording a fresh expense.</p>
</section>

<% if (govStakeholders.length > 0) { %>
<section class="bg-white rounded-xl border border-ink/10 overflow-hidden">
  <div class="px-5 py-3 border-b border-ink/10">
    <h2 class="font-display text-lg">Government Agencies</h2>
    <p class="text-xs text-ink/40">Stakeholders with category Government — KRA, county government, NHIF, NSSF, etc.</p>
  </div>
  <div class="table-wrap">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
          <th class="px-5 py-2">Agency</th>
          <th class="px-5 py-2">Role</th>
          <th class="px-5 py-2">Contact</th>
        </tr>
      </thead>
      <tbody>
        <% govStakeholders.forEach(function(s) { %>
        <tr class="border-b border-ink/5 last:border-0">
          <td class="px-5 py-3 font-display"><%= s.name %></td>
          <td class="px-5 py-3 text-xs text-ink/60"><%= s.role %></td>
          <td class="px-5 py-3 text-xs text-ink/50"><%= s.phone || s.email || '—' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<% } %>
