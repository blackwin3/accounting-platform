<header class="mb-8">
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Organisation</p>
  <h1 class="font-display text-3xl mt-1"><%= orgName %></h1>
  <p class="text-ink/50 text-sm mt-1">Active currency: <span class="font-mono"><%= currency.code %></span> (<%= currency.name %>)</p>
</header>

<div class="grid md:grid-cols-3 gap-4 mb-8">
  <!-- Business -->
  <a href="/organisation/business" class="bg-white rounded-xl border border-ink/10 p-5 hover:border-till/40 transition block">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Business</p>
    <p class="font-display text-lg">Setup &amp; Profile</p>
    <p class="text-xs text-ink/40 mt-1">Industry, currency, business units</p>
  </a>

  <!-- Stakeholders -->
  <a href="/organisation/stakeholders" class="bg-white rounded-xl border border-ink/10 p-5 hover:border-till/40 transition block">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Stakeholders</p>
    <p class="font-display text-lg"><%= summary.stakeholders.total %> people &amp; entities</p>
    <div class="flex gap-3 text-xs text-ink/40 mt-1">
      <span><%= summary.stakeholders.suppliers %> suppliers</span>
      <span><%= summary.stakeholders.customers %> customers</span>
    </div>
  </a>

  <!-- Management & HR -->
  <a href="/organisation/management" class="bg-white rounded-xl border border-ink/10 p-5 hover:border-till/40 transition block">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Team &amp; Payroll</p>
    <p class="font-display text-lg"><%= summary.team.active %> active members</p>
    <p class="text-xs text-ink/40 mt-1">Monthly payroll: <%= fmt(summary.team.monthlyPayroll) %></p>
  </a>

  <!-- Government -->
  <a href="/organisation/government" class="bg-white rounded-xl border border-ink/10 p-5 hover:border-till/40 transition block">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Government</p>
    <p class="font-display text-lg">Taxes &amp; Levies</p>
    <p class="text-xs text-ink/40 mt-1">Compliance, grants, annual charges</p>
  </a>

  <!-- Products -->
  <a href="/products" class="bg-white rounded-xl border border-ink/10 p-5 hover:border-till/40 transition block">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Products</p>
    <p class="font-display text-lg"><%= summary.products %> products</p>
    <p class="text-xs text-ink/40 mt-1">Goods, services, utilities</p>
  </a>

  <!-- Livestock -->
  <a href="/organisation/livestock" class="bg-white rounded-xl border border-ink/10 p-5 hover:border-till/40 transition block">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Agriculture</p>
    <p class="font-display text-lg"><%= summary.livestock %> biological assets</p>
    <p class="text-xs text-ink/40 mt-1">Animals, crops, fair value</p>
  </a>

  <!-- Processing -->
  <a href="/organisation/processing" class="bg-white rounded-xl border border-ink/10 p-5 hover:border-till/40 transition block">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Processing</p>
    <p class="font-display text-lg">Repackaging</p>
    <p class="text-xs text-ink/40 mt-1">Eggs → trays, bulk → bottles</p>
  </a>

  <!-- Services -->
  <a href="/organisation/services-wip" class="bg-white rounded-xl border border-ink/10 p-5 hover:border-till/40 transition block">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Services</p>
    <p class="font-display text-lg">Engagements</p>
    <p class="text-xs text-ink/40 mt-1">Time-based billing, equipment hire</p>
  </a>
</div>
