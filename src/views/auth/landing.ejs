<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nzovu — Accounting for the whole family enterprise</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: { paper: '#F6F3EC', ink: '#232019', till: '#1F5E45', tillDark: '#153F2E', clay: '#B45B3C' },
          fontFamily: { display: ['Georgia', 'serif'], mono: ['"Courier New"', 'monospace'] },
        },
      },
    };
  </script>
</head>
<body class="bg-paper text-ink font-sans">

  <!-- Top bar -->
  <header class="border-b-2 border-ink/10">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="font-display text-xl tracking-tight">Nzovu</a>
      <nav class="flex items-center gap-3">
        <a href="/about" class="text-sm text-ink/60 hover:text-ink transition mr-3">About</a>
        <% if (typeof showSignup !== 'undefined' && showSignup) { %>
          <a href="/setup" class="px-5 py-2 rounded-full border border-ink/20 text-sm font-medium hover:bg-white transition">Sign up</a>
        <% } %>
        <a href="/login" class="px-5 py-2 rounded-full bg-till text-paper text-sm font-medium hover:brightness-110 transition">Sign in</a>
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-16 grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-till mb-4">Accounting built for how family businesses actually work</p>
      <h1 class="font-display text-5xl leading-tight">
        One ledger for the shop, the farm, the rentals, and everything in between.
      </h1>
      <p class="text-ink/60 text-lg mt-6 max-w-xl">
        Nzovu is a double-entry accounting platform for small and family-run enterprises with more than one thing going on — a retail shop that also runs a farm, a landlord who also holds a loan, a business that will one day pass to the next generation.
      </p>
      <div class="flex gap-4 mt-8">
        <a href="/login" class="px-6 py-3 rounded-full bg-till text-paper font-display text-lg hover:brightness-110 transition">Sign in</a>
        <a href="/about" class="px-6 py-3 rounded-full border border-ink/20 font-display text-lg hover:bg-white transition">Learn more</a>
      </div>
    </div>

    <!-- Custom illustration: shopkeeper at the counter, till-tape receipt curling out -->
    <div class="relative">
      <svg viewBox="0 0 480 400" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
        <!-- backdrop -->
        <rect x="0" y="0" width="480" height="400" rx="24" fill="#FFFFFF" stroke="#23201A" stroke-opacity="0.08" stroke-width="2"/>

        <!-- shelf with goods, back wall -->
        <rect x="40" y="60" width="400" height="10" fill="#23201A" fill-opacity="0.08"/>
        <rect x="60" y="30" width="26" height="30" rx="3" fill="#B45B3C"/>
        <rect x="94" y="26" width="26" height="34" rx="3" fill="#1F5E45"/>
        <rect x="128" y="32" width="26" height="28" rx="3" fill="#B45B3C" fill-opacity="0.6"/>
        <rect x="162" y="28" width="26" height="32" rx="3" fill="#1F5E45" fill-opacity="0.7"/>
        <rect x="300" y="28" width="26" height="32" rx="3" fill="#1F5E45" fill-opacity="0.5"/>
        <rect x="334" y="32" width="26" height="28" rx="3" fill="#B45B3C" fill-opacity="0.7"/>
        <rect x="368" y="26" width="26" height="34" rx="3" fill="#1F5E45"/>

        <!-- counter -->
        <rect x="20" y="250" width="440" height="90" rx="10" fill="#153F2E"/>
        <rect x="20" y="250" width="440" height="14" rx="7" fill="#1F5E45"/>

        <!-- till / register on counter -->
        <rect x="330" y="205" width="90" height="55" rx="6" fill="#F6F3EC" stroke="#23201A" stroke-opacity="0.15" stroke-width="2"/>
        <rect x="340" y="215" width="70" height="22" rx="3" fill="#23201A" fill-opacity="0.08"/>
        <!-- receipt curling from till -->
        <path d="M355 205 C 350 190, 365 178, 358 165 C 352 154, 368 145, 362 132" stroke="#23201A" stroke-opacity="0.25" stroke-width="10" fill="none" stroke-linecap="round"/>

        <!-- shopkeeper behind counter -->
        <circle cx="140" cy="200" r="26" fill="#B45B3C"/>
        <rect x="112" y="222" width="56" height="60" rx="16" fill="#1F5E45"/>
        <rect x="112" y="222" width="56" height="18" rx="9" fill="#153F2E"/>

        <!-- customer in front of counter -->
        <circle cx="250" cy="230" r="22" fill="#23201A" fill-opacity="0.7"/>
        <rect x="226" y="250" width="48" height="70" rx="14" fill="#B45B3C" fill-opacity="0.85"/>

        <!-- small basket/product on counter between them -->
        <rect x="195" y="238" width="34" height="20" rx="4" fill="#F6F3EC" stroke="#23201A" stroke-opacity="0.15" stroke-width="2"/>

        <!-- floor line -->
        <rect x="20" y="340" width="440" height="4" fill="#23201A" fill-opacity="0.06"/>
      </svg>
    </div>
  </section>

  <!-- Receipt-style feature strip -->
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-white rounded-xl border border-ink/10 p-6">
        <svg viewBox="0 0 64 64" class="w-12 h-12 mb-4">
          <rect x="6" y="30" width="20" height="24" rx="3" fill="#1F5E45"/>
          <rect x="30" y="18" width="20" height="36" rx="3" fill="#B45B3C"/>
          <rect x="6" y="30" width="20" height="8" rx="3" fill="#153F2E"/>
          <rect x="30" y="18" width="20" height="8" rx="3" fill="#8f3f27"/>
          <path d="M26 42 L30 42" stroke="#23201A" stroke-opacity="0.3" stroke-width="3" stroke-linecap="round"/>
        </svg>
        <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Multiple Units</p>
        <p class="font-display text-lg mb-2">Shop, farm, rentals, investments — one business.</p>
        <p class="text-ink/50 text-sm">Switch between business units without losing sight of the whole enterprise. Internal transfers are tracked properly, so nothing gets double-counted.</p>
      </div>
      <div class="bg-white rounded-xl border border-ink/10 p-6">
        <svg viewBox="0 0 64 64" class="w-12 h-12 mb-4">
          <rect x="10" y="8" width="44" height="48" rx="4" fill="#F6F3EC" stroke="#23201A" stroke-opacity="0.15" stroke-width="2"/>
          <rect x="18" y="18" width="28" height="4" rx="2" fill="#1F5E45"/>
          <rect x="18" y="28" width="18" height="4" rx="2" fill="#23201A" fill-opacity="0.3"/>
          <rect x="18" y="38" width="22" height="4" rx="2" fill="#23201A" fill-opacity="0.3"/>
          <circle cx="46" cy="40" r="3" fill="#B45B3C"/>
        </svg>
        <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Real Double-Entry</p>
        <p class="font-display text-lg mb-2">Every sale, expense, and asset — balanced.</p>
        <p class="text-ink/50 text-sm">Built on proper debit/credit accounting from the ground up, with trial balances, income statements, and balance sheets generated from the actual ledger.</p>
      </div>
      <div class="bg-white rounded-xl border border-ink/10 p-6">
        <svg viewBox="0 0 64 64" class="w-12 h-12 mb-4">
          <circle cx="24" cy="22" r="10" fill="#1F5E45"/>
          <path d="M14 44 C14 34, 34 34, 34 44" fill="#1F5E45"/>
          <circle cx="44" cy="30" r="8" fill="#B45B3C"/>
          <path d="M36 48 C36 40, 52 40, 52 48" fill="#B45B3C"/>
        </svg>
        <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Built to Be Handed Down</p>
        <p class="font-display text-lg mb-2">Knowledge, not just numbers.</p>
        <p class="text-ink/50 text-sm">Record why decisions were made, not just what happened — so the next generation inherits the reasoning behind the business, not just its balance sheet.</p>
      </div>
    </div>
  </section>

  <!-- Till-tape signature strip -->
  <section class="bg-tillDark text-paper">
    <div class="max-w-6xl mx-auto px-6 py-14 text-center">
      <p class="font-mono text-xs uppercase tracking-widest text-paper/50 mb-3">Ready when you are</p>
      <h2 class="font-display text-3xl mb-6">Bring your business onto one ledger.</h2>
      <a href="/login" class="inline-block px-6 py-3 rounded-full bg-clay text-paper font-display text-lg hover:brightness-110 transition">Sign in to Nzovu</a>
    </div>
  </section>

  <footer class="border-t-2 border-ink/10">
    <div class="max-w-6xl mx-auto px-6 py-8 flex items-center justify-between text-sm text-ink/40">
      <span class="font-display">Nzovu</span>
      <div class="flex gap-6">
        <a href="/about" class="hover:text-ink transition">About</a>
        <a href="/login" class="hover:text-ink transition">Sign in</a>
      </div>
    </div>
  </footer>

</body>
</html>
