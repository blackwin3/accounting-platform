<header class="mb-8">
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Settings</p>
  <h1 class="font-display text-3xl mt-1">Profile</h1>
  <p class="text-ink/50 text-sm mt-1">Your account, what it can access, and system health.</p>
</header>

<div class="grid md:grid-cols-2 gap-6">
  <!-- LEFT: Account and access -->
  <div class="space-y-6">
    <section class="bg-white rounded-xl border border-ink/10 p-6">
      <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-3">Account</p>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between"><span class="text-ink/50">Name</span><span class="font-display"><%= profile.name %></span></div>
        <div class="flex justify-between"><span class="text-ink/50">Username</span><span class="font-mono">@<%= profile.username %></span></div>
        <div class="flex justify-between"><span class="text-ink/50">Role</span><span><%= profile.role %></span></div>
        <div class="flex justify-between"><span class="text-ink/50">Access Level</span><span class="font-mono text-xs px-2 py-0.5 rounded-full bg-paper"><%= profile.accessLevel %></span></div>
        <% if (profile.inheritanceStatus) { %>
          <div class="flex justify-between"><span class="text-ink/50">Succession Status</span><span class="font-mono text-xs"><%= profile.inheritanceStatus %></span></div>
        <% } %>
      </div>
    </section>

    <section class="bg-white rounded-xl border border-ink/10 p-6">
      <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-3">What you can access</p>
      <div class="grid grid-cols-2 gap-2">
        <% permissions.forEach(function(p) { %>
          <div class="flex items-center gap-2 text-sm">
            <span class="w-1.5 h-1.5 rounded-full <%= p.allowed ? 'bg-till' : 'bg-ink/15' %>"></span>
            <span class="<%= p.allowed ? 'text-ink' : 'text-ink/30' %>"><%= p.label %></span>
          </div>
        <% }) %>
      </div>
    </section>
  </div>

  <!-- RIGHT: Diagnostics, Succession, tools -->
  <div class="space-y-6">
    <section class="bg-white rounded-xl border border-ink/10 p-6">
      <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-3">System Health</p>
      <p class="text-ink/50 text-sm mb-3">Check the accounting data for errors — balance drift, unbalanced journals, negative cash, duplicate transactions.</p>
      <button id="diag-btn" class="w-full py-2 rounded-lg bg-till text-paper text-sm font-medium hover:brightness-110 transition">Run Diagnostics</button>
      <div id="diag-results" class="hidden mt-3 space-y-2"></div>
    </section>

    <section class="bg-white rounded-xl border border-ink/10 p-6">
      <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-3">Succession Plan</p>
      <p class="text-ink/50 text-sm mb-3">View who takes over this business, what has been decided, and the legal status of each role.</p>
      <a href="/settings/succession" class="block w-full py-2 rounded-lg border border-till text-till text-center text-sm font-medium hover:bg-till/5 transition">View Succession Plan</a>
    </section>
  </div>
</div>

<% if (canReset) { %>
<section class="mt-12 border-t border-clay/20 pt-8">
  <h2 class="font-display text-xl text-clay mb-2">Reset Account</h2>
  <p class="text-ink/50 text-sm mb-4">Clears all transactions, journal entries, inventory, and financial records. Keeps your business setup, products, team, and chart of accounts. <strong>This cannot be undone.</strong></p>
  <div class="flex items-end gap-3">
    <div>
      <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Type RESET to confirm</label>
      <input id="reset-confirm" type="text" class="border border-clay/30 rounded-lg px-3 py-2 font-mono text-sm w-40" placeholder="RESET" />
    </div>
    <button id="reset-btn" class="bg-clay text-paper rounded-lg px-4 py-2 text-sm font-medium hover:bg-clay/90 transition">Reset Account</button>
  </div>
  <p id="reset-msg" class="text-sm mt-2 hidden"></p>
</section>
<% } %>

<script>
// Diagnostics
document.getElementById('diag-btn').addEventListener('click', async () => {
  const btn = document.getElementById('diag-btn');
  const results = document.getElementById('diag-results');
  btn.textContent = 'Running…'; btn.disabled = true;
  try {
    const res = await fetch('/api/diagnostics');
    if (res.status === 401) { window.location.href = '/login'; return; }
    const data = await res.json();
    results.innerHTML = data.results.map(r => {
      const color = r.passed ? 'bg-till/10 text-till' : r.severity === 'BLOCK' ? 'bg-clay/10 text-clay' : r.severity === 'WARN' ? 'bg-amber-50 text-amber-700' : 'bg-paper text-ink/60';
      const icon = r.passed ? '✓' : r.severity === 'BLOCK' ? '✗' : '⚠';
      return '<div class="' + color + ' rounded-lg px-3 py-2 text-xs">' + icon + ' <strong>' + r.name + '</strong> — ' + r.detail + '</div>';
    }).join('');
    results.classList.remove('hidden');
  } catch (e) {
    results.innerHTML = '<div class="bg-clay/10 text-clay rounded-lg px-3 py-2 text-xs">Failed: ' + e.message + '</div>';
    results.classList.remove('hidden');
  }
  btn.textContent = 'Run Again'; btn.disabled = false;
});

// Reset
<% if (canReset) { %>
document.getElementById('reset-btn').addEventListener('click', async () => {
  const val = document.getElementById('reset-confirm').value.trim();
  const msgEl = document.getElementById('reset-msg');
  if (val !== 'RESET') { msgEl.textContent = 'Type RESET exactly to confirm.'; msgEl.className = 'text-sm mt-2 text-clay'; return; }
  if (!confirm('Are you sure? All transactions will be permanently deleted.')) return;
  document.getElementById('reset-btn').disabled = true;
  document.getElementById('reset-btn').textContent = 'Resetting…';
  try {
    const res = await fetch('/settings/reset-account', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ confirm: 'RESET' }) });
    const text = await res.text();
    let data; try { data = JSON.parse(text); } catch(e) { throw new Error('Server error'); }
    if (!res.ok) throw new Error(data.error || 'Reset failed');
    msgEl.textContent = data.message;
    msgEl.className = 'text-sm mt-2 text-till';
    setTimeout(() => location.reload(), 1500);
  } catch (e) {
    msgEl.textContent = e.message;
    msgEl.className = 'text-sm mt-2 text-clay';
    document.getElementById('reset-btn').disabled = false;
    document.getElementById('reset-btn').textContent = 'Reset Account';
  }
});
<% } %>
</script>
