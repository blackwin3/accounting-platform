<header class="mb-8">
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Insights</p>
  <h1 class="font-display text-3xl mt-1">Knowledge</h1>
  <p class="text-ink/50 text-sm mt-1">Institutional memory — decisions, lessons, and recommendations written for future owners, accountants, and successors.</p>
</header>

<div class="space-y-4">
  <% entries.forEach(function(k) { %>
    <div class="bg-white rounded-xl border border-ink/10 p-6">
      <div class="flex items-start justify-between mb-2">
        <div>
          <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-paper text-ink/60"><%= k.type %></span>
          <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-till/10 text-till ml-1"><%= k.context %></span>
        </div>
        <span class="text-xs text-ink/30 font-mono"><%= k.date %></span>
      </div>
      <p class="font-display text-lg mb-2"><%= k.explanation %></p>
      <% if (k.decisionReason) { %><p class="text-sm text-ink/60 mb-2"><strong class="text-ink/80">Why:</strong> <%= k.decisionReason %></p><% } %>
      <% if (k.recommendation) { %><p class="text-sm text-ink/60 mb-2"><strong class="text-ink/80">Recommendation:</strong> <%= k.recommendation %></p><% } %>
      <% if (k.lessonLearned) { %><p class="text-sm text-ink/60 mb-2"><strong class="text-ink/80">Lesson:</strong> <%= k.lessonLearned %></p><% } %>
      <p class="text-xs text-ink/40 mt-3">Written by <%= k.author %></p>
    </div>
  <% }) %>
  <% if (entries.length === 0) { %>
    <div class="bg-white rounded-xl border border-ink/10 p-8 text-center text-ink/40">No knowledge entries recorded yet.</div>
  <% } %>
</div>
