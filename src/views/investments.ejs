<header class="mb-8">
  <a href="/money" class="text-ink/40 hover:text-till text-sm">← Money</a>
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mt-2">Money Movement — <%= currentBusinessUnit %></p>
  <h1 class="font-display text-3xl mt-1">Investments</h1>
  <p class="text-ink/50 text-sm mt-1">Money put into something expecting a return, in two genuinely different shapes: an intangible Money Market instrument (bonds, shares — buy, hold, sell), or a physical Rental Property (a real Asset with depreciation, let out to a Tenant for recurring income).</p>
</header>

<section class="mb-8 grid grid-cols-2 gap-4 max-w-md">
  <div class="bg-white rounded-xl border border-ink/10 p-5">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Money Market (Active)</p>
    <p class="font-mono text-2xl tabular-nums text-till"><%= fmt(totalHeld) %></p>
  </div>
  <div class="bg-white rounded-xl border border-ink/10 p-5">
    <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Rental Property (Cost)</p>
    <p class="font-mono text-2xl tabular-nums text-till"><%= fmt(totalRentalValue) %></p>
  </div>
</section>

<h2 class="font-display text-2xl mb-4">Money Market</h2>
<div class="grid md:grid-cols-2 gap-6 mb-10">
  <!-- Buy -->
  <section class="bg-white rounded-xl border border-ink/10 p-6">
    <h2 class="font-display text-xl mb-1">Acquire an Investment</h2>
    <p class="text-ink/50 text-sm mb-5">Buy a bond, shares, or similar instrument.</p>
    <form id="buy-form" class="space-y-4">
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Name</label>
        <input name="name" type="text" required placeholder="e.g. KE Infrastructure Bond — 10yr" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display" />
      </div>
      <% if (investmentProducts.length > 0) { %>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Link to Product (optional)</label>
        <select name="productId" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
          <option value="">— none —</option>
          <% investmentProducts.forEach(function(p) { %>
            <option value="<%= p.id %>"><%= p.name %></option>
          <% }) %>
        </select>
      </div>
      <% } %>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Amount (KES)</label>
        <input name="amount" type="number" min="0.01" step="0.01" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Interest Rate % (optional)</label>
          <input name="interestRate" type="number" min="0" step="0.01" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Maturity Date (optional)</label>
          <input name="maturityDate" type="date" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        </div>
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Paid Via</label>
        <div class="grid grid-cols-3 gap-1.5">
          <label><input type="radio" name="paymentMethod" value="CASH" checked class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Cash</div></label>
          <label><input type="radio" name="paymentMethod" value="MOBILE" class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Mobile</div></label>
          <label><input type="radio" name="paymentMethod" value="BANK" class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Bank</div></label>
        </div>
      </div>
      <button type="submit" id="buy-submit" class="w-full py-3 rounded-lg bg-till text-paper font-display text-lg hover:brightness-110 transition">Acquire Investment</button>
      <div id="buy-feedback" class="hidden text-sm p-3 rounded-lg"></div>
    </form>
  </section>

  <!-- Sell -->
  <section class="bg-white rounded-xl border border-ink/10 p-6">
    <h2 class="font-display text-xl mb-1">Sell or Redeem</h2>
    <p class="text-ink/50 text-sm mb-5">Realises a gain or loss against the original amount invested.</p>
    <% if (activeHoldings.length === 0) { %>
      <p class="text-ink/40 text-sm">No active investments to sell.</p>
    <% } else { %>
      <form id="sell-form" class="space-y-4">
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Investment</label>
          <select name="moneyId" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
            <% activeHoldings.forEach(function(h) { %>
              <option value="<%= h.id %>"><%= h.name %> — carrying amount <%= fmt(h.principal) %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Proceeds Received (KES)</label>
          <input name="proceeds" type="number" min="0" step="0.01" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
          <p class="text-xs text-ink/40 mt-1">Above or below the carrying amount is recorded as a gain or loss.</p>
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Received Via</label>
          <div class="grid grid-cols-3 gap-1.5">
            <label><input type="radio" name="paymentMethod" value="CASH" checked class="peer sr-only" /><div class="peer-checked:bg-clay peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Cash</div></label>
            <label><input type="radio" name="paymentMethod" value="MOBILE" class="peer sr-only" /><div class="peer-checked:bg-clay peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Mobile</div></label>
            <label><input type="radio" name="paymentMethod" value="BANK" class="peer sr-only" /><div class="peer-checked:bg-clay peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Bank</div></label>
          </div>
        </div>
        <button type="submit" id="sell-submit" class="w-full py-3 rounded-lg bg-clay text-paper font-display text-lg hover:brightness-110 transition">Sell / Redeem</button>
        <div id="sell-feedback" class="hidden text-sm p-3 rounded-lg"></div>
      </form>
    <% } %>
  </section>
</div>

<!-- Investment Calculator -->
<section class="bg-white rounded-xl border border-ink/10 p-6 mb-10">
  <h2 class="font-display text-xl mb-1">Investment Calculator</h2>
  <p class="text-ink/50 text-sm mb-5">See how your money grows before you commit. Enter the amount, the annual return rate (the bank or broker will tell you this), and how long you plan to keep it.</p>

  <div class="grid md:grid-cols-2 gap-6">
    <!-- Left: Input board -->
    <div class="space-y-4">
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Amount to Invest (KES)</label>
        <input id="calc-amount" type="number" min="1" step="1" value="100000" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Annual Return Rate (%)</label>
        <input id="calc-rate" type="number" min="0.01" max="100" step="0.01" value="12" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        <p class="text-xs text-ink/40 mt-1">The bank calls this "coupon rate" or "yield". Treasury bills: ~10–16%. Bonds: ~12–14%. Fixed deposit: ~7–10%.</p>
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Duration (years)</label>
        <input id="calc-years" type="number" min="1" max="30" step="1" value="5" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Interest Type</label>
        <select id="calc-type" class="w-full border border-ink/20 rounded-lg px-3 py-2">
          <option value="simple">Simple Interest (you earn the same amount each year)</option>
          <option value="compound" selected>Compound Interest (your earnings also earn — grows faster)</option>
        </select>
      </div>
      <button id="calc-btn" class="bg-till text-paper rounded-lg px-4 py-2 text-sm font-medium w-full">Calculate</button>

      <div id="calc-summary" class="hidden bg-paper rounded-lg p-4 space-y-1">
        <p class="font-mono text-xs uppercase tracking-widest text-ink/40">After <span id="calc-sum-years"></span> years</p>
        <p class="font-display text-xl">You get back: KES <span id="calc-sum-total" class="text-till font-mono"></span></p>
        <p class="text-sm text-ink/50">Total interest earned: KES <span id="calc-sum-interest" class="font-mono"></span></p>
        <p class="text-sm text-ink/50">That's <span id="calc-sum-pct" class="font-mono"></span>% return on your KES <span id="calc-sum-principal" class="font-mono"></span></p>
      </div>
    </div>

    <!-- Right: Year-by-year growth table -->
    <div>
      <div class="table-wrap">
        <table id="calc-table" class="w-full text-sm hidden">
          <thead>
            <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
              <th class="px-3 py-2">Year</th>
              <th class="px-3 py-2 text-right">Opening</th>
              <th class="px-3 py-2 text-right">Interest</th>
              <th class="px-3 py-2 text-right">Closing</th>
            </tr>
          </thead>
          <tbody id="calc-rows"></tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script>
document.getElementById('calc-btn').addEventListener('click', function() {
  const principal = Number(document.getElementById('calc-amount').value) || 0;
  const rate = Number(document.getElementById('calc-rate').value) || 0;
  const years = Number(document.getElementById('calc-years').value) || 1;
  const type = document.getElementById('calc-type').value;
  if (principal <= 0 || rate <= 0) return;

  const fmt = (n) => n.toLocaleString('en-KE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const rows = [];
  let balance = principal;

  for (let y = 1; y <= years; y++) {
    const interest = type === 'compound'
      ? balance * (rate / 100)
      : principal * (rate / 100);
    const closing = balance + interest;
    rows.push({ year: y, opening: balance, interest, closing });
    balance = closing;
  }

  const totalInterest = balance - principal;
  const tbody = document.getElementById('calc-rows');
  tbody.innerHTML = rows.map(r =>
    '<tr class="border-b border-ink/5">' +
    '<td class="px-3 py-2 font-mono">' + r.year + '</td>' +
    '<td class="px-3 py-2 text-right font-mono tabular-nums">' + fmt(r.opening) + '</td>' +
    '<td class="px-3 py-2 text-right font-mono tabular-nums text-till">' + fmt(r.interest) + '</td>' +
    '<td class="px-3 py-2 text-right font-mono tabular-nums font-medium">' + fmt(r.closing) + '</td>' +
    '</tr>'
  ).join('');
  document.getElementById('calc-table').classList.remove('hidden');

  document.getElementById('calc-sum-years').textContent = years;
  document.getElementById('calc-sum-total').textContent = fmt(balance);
  document.getElementById('calc-sum-interest').textContent = fmt(totalInterest);
  document.getElementById('calc-sum-principal').textContent = fmt(principal);
  document.getElementById('calc-sum-pct').textContent = ((totalInterest / principal) * 100).toFixed(1);
  document.getElementById('calc-summary').classList.remove('hidden');
});
</script>

<h2 class="font-display text-2xl mb-4">Rental Property</h2>
<div class="grid md:grid-cols-2 gap-6 mb-10">
  <!-- Buy Rental Property -->
  <section class="bg-white rounded-xl border border-ink/10 p-6">
    <h2 class="font-display text-xl mb-1">Acquire a Rental Property</h2>
    <p class="text-ink/50 text-sm mb-5">A real Asset — genuinely depreciated over its useful life, the same as any other fixed asset — with a Tenant and agreed rent attached.</p>
    <form id="rental-buy-form" class="space-y-4">
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Name</label>
        <input name="name" type="text" required placeholder="e.g. House A — Nakuru" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display" />
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Cost (KES)</label>
        <input name="cost" type="number" min="0.01" step="0.01" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Useful Life (years)</label>
          <input name="usefulLifeYears" type="number" min="1" step="1" required value="30" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Residual Value (optional)</label>
          <input name="residualValue" type="number" min="0" step="0.01" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        </div>
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Tenant (optional)</label>
        <select name="tenantStakeholderId" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
          <option value="">— vacant —</option>
          <% availableTenants.forEach(function(t) { %>
            <option value="<%= t.id %>"><%= t.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Agreed Monthly Rent (optional)</label>
        <input name="monthlyRent" type="number" min="0" step="0.01" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        <p class="text-xs text-ink/40 mt-1">A record of the agreement, not a posting — collecting rent is its own separate event through Money → Funds each time it's genuinely received.</p>
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Paid Via</label>
        <div class="grid grid-cols-3 gap-1.5">
          <label><input type="radio" name="paymentMethod" value="CASH" checked class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Cash</div></label>
          <label><input type="radio" name="paymentMethod" value="MOBILE" class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Mobile</div></label>
          <label><input type="radio" name="paymentMethod" value="BANK" class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Bank</div></label>
        </div>
      </div>
      <button type="submit" id="rental-buy-submit" class="w-full py-3 rounded-lg bg-till text-paper font-display text-lg hover:brightness-110 transition">Acquire Property</button>
      <div id="rental-buy-feedback" class="hidden text-sm p-3 rounded-lg"></div>
    </form>
  </section>

  <!-- Reassign Tenant -->
  <section class="bg-white rounded-xl border border-ink/10 p-6">
    <h2 class="font-display text-xl mb-1">Change Tenant</h2>
    <p class="text-ink/50 text-sm mb-5">A new tenant moving in, or a property becoming vacant. No posting — this is a change to the agreement on record.</p>
    <% if (rentalProperties.length === 0) { %>
      <p class="text-ink/40 text-sm">No rental properties yet.</p>
    <% } else { %>
      <form id="reassign-form" class="space-y-4">
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Property</label>
          <select id="reassign-asset" name="assetsId" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
            <% rentalProperties.forEach(function(p) { %>
              <option value="<%= p.id %>"><%= p.name %> <%= p.tenantName ? '(currently ' + p.tenantName + ')' : '(vacant)' %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">New Tenant</label>
          <select name="tenantStakeholderId" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
            <option value="">— vacant —</option>
            <% availableTenants.forEach(function(t) { %>
              <option value="<%= t.id %>"><%= t.name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">New Agreed Rent (optional)</label>
          <input name="monthlyRent" type="number" min="0" step="0.01" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        </div>
        <button type="submit" id="reassign-submit" class="w-full py-3 rounded-lg bg-ink/80 text-paper font-display text-lg hover:brightness-110 transition">Update Tenancy</button>
        <div id="reassign-feedback" class="hidden text-sm p-3 rounded-lg"></div>
      </form>
    <% } %>
  </section>
</div>

<section class="mb-10">
  <h2 class="font-display text-xl mb-4">Rental Property Register</h2>
  <div class="bg-white rounded-xl border border-ink/10 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
          <th class="px-5 py-3">Property</th>
          <th class="px-5 py-3">Tenant</th>
          <th class="px-5 py-3 text-right">Cost</th>
          <th class="px-5 py-3 text-right">Carrying Amount</th>
          <th class="px-5 py-3 text-right">Monthly Rent</th>
        </tr>
      </thead>
      <tbody>
        <% rentalProperties.forEach(function(p) { %>
          <tr class="border-b border-ink/5 last:border-0 hover:bg-paper/50">
            <td class="px-5 py-3 font-display"><%= p.name %></td>
            <td class="px-5 py-3">
              <% if (p.tenantName) { %>
                <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-till/10 text-till"><%= p.tenantName %></span>
              <% } else { %>
                <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-clay/10 text-clay">Vacant</span>
              <% } %>
            </td>
            <td class="px-5 py-3 text-right font-mono tabular-nums"><%= fmt(p.cost) %></td>
            <td class="px-5 py-3 text-right font-mono tabular-nums text-till"><%= fmt(p.carryingAmount) %></td>
            <td class="px-5 py-3 text-right font-mono tabular-nums"><%= p.monthlyRent !== null ? fmt(p.monthlyRent) : '—' %></td>
          </tr>
        <% }) %>
        <% if (rentalProperties.length === 0) { %>
          <tr><td colspan="5" class="px-5 py-8 text-center text-ink/40">No rental properties yet for <%= currentBusinessUnit %>.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<h2 class="font-display text-2xl mb-4">Money Market — Holdings</h2>
<section class="mb-10">
  <h2 class="font-display text-xl mb-4">Active Holdings</h2>
  <div class="bg-white rounded-xl border border-ink/10 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
          <th class="px-5 py-3">Name</th>
          <th class="px-5 py-3">Class</th>
          <th class="px-5 py-3 text-right">Principal</th>
          <th class="px-5 py-3 text-right">Rate</th>
          <th class="px-5 py-3">Start</th>
          <th class="px-5 py-3">Maturity</th>
        </tr>
      </thead>
      <tbody>
        <% activeHoldings.forEach(function(h) { %>
          <tr class="border-b border-ink/5 last:border-0 hover:bg-paper/50">
            <td class="px-5 py-3 font-display"><%= h.name %></td>
            <td class="px-5 py-3 text-xs text-ink/50"><%= h.instrumentClass %></td>
            <td class="px-5 py-3 text-right font-mono tabular-nums text-till"><%= fmt(h.principal) %></td>
            <td class="px-5 py-3 text-right font-mono tabular-nums"><%= h.interestRate !== null ? h.interestRate + '%' : '—' %></td>
            <td class="px-5 py-3 text-xs text-ink/50"><%= h.startDate %></td>
            <td class="px-5 py-3 text-xs text-ink/50"><%= h.maturityDate %></td>
          </tr>
        <% }) %>
        <% if (activeHoldings.length === 0) { %>
          <tr><td colspan="6" class="px-5 py-8 text-center text-ink/40">No active investments.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<% if (closedHoldings.length > 0) { %>
<section>
  <h2 class="font-display text-xl mb-4">History</h2>
  <div class="bg-white rounded-xl border border-ink/10 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
          <th class="px-5 py-3">Name</th>
          <th class="px-5 py-3">Status</th>
          <th class="px-5 py-3 text-right">Original Principal</th>
        </tr>
      </thead>
      <tbody>
        <% closedHoldings.forEach(function(h) { %>
          <tr class="border-b border-ink/5 last:border-0 hover:bg-paper/50 opacity-60">
            <td class="px-5 py-3 font-display"><%= h.name %></td>
            <td class="px-5 py-3">
              <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-ink/10 text-ink/50"><%= h.status %></span>
            </td>
            <td class="px-5 py-3 text-right font-mono tabular-nums"><%= fmt(h.principal) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<% } %>

<script>
  function fmtNum(n) {
    const num = Number(n || 0);
    const sign = num < 0 ? "-" : "";
    const abs = Math.abs(num);
    const [whole, decimals] = abs.toFixed(2).split(".");
    const withCommas = whole.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    return `${sign}${withCommas}.${decimals}`;
  }

  function wireForm(formId, feedbackId, submitId, url, buildBody, successMessage) {
    const form = document.getElementById(formId);
    if (!form) return;
    const feedback = document.getElementById(feedbackId);
    const submitBtn = document.getElementById(submitId);
    const originalText = submitBtn.textContent;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = "Posting...";
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(buildBody(data)),
        });
        const result = await res.json();
        if (!res.ok) throw new Error(result.error || "Failed to post");
        feedback.textContent = successMessage(result, data);
        feedback.className = "text-sm p-3 rounded-lg bg-till/10 text-till";
        feedback.classList.remove("hidden");
        setTimeout(() => location.reload(), 900);
      } catch (err) {
        feedback.textContent = err.message;
        feedback.className = "text-sm p-3 rounded-lg bg-clay/10 text-clay";
        feedback.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  }

  wireForm("buy-form", "buy-feedback", "buy-submit", "/api/investment-purchase",
    (data) => ({
      name: data.name,
      amount: Number(data.amount),
      paymentMethod: data.paymentMethod,
      interestRate: data.interestRate || null,
      maturityDate: data.maturityDate || null,
      productId: data.productId || null,
    }),
    () => "Investment acquired.");

  wireForm("sell-form", "sell-feedback", "sell-submit", "/api/investment-sale",
    (data) => ({ moneyId: Number(data.moneyId), proceeds: Number(data.proceeds), paymentMethod: data.paymentMethod }),
    (result) => `Sold — ${result.gainLoss >= 0 ? "gain" : "loss"} of KES ${fmtNum(Math.abs(result.gainLoss))}.`);

  wireForm("rental-buy-form", "rental-buy-feedback", "rental-buy-submit", "/api/investments/rental-property",
    (data) => ({
      name: data.name,
      cost: Number(data.cost),
      usefulLifeYears: Number(data.usefulLifeYears),
      residualValue: data.residualValue || null,
      paymentMethod: data.paymentMethod,
      tenantStakeholderId: data.tenantStakeholderId || null,
      monthlyRent: data.monthlyRent || null,
    }),
    () => "Rental property acquired.");

  // Reassign posts to a per-asset URL, so it needs its own handler rather
  // than the shared wireForm's fixed-URL pattern.
  const reassignForm = document.getElementById("reassign-form");
  if (reassignForm) {
    reassignForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const feedback = document.getElementById("reassign-feedback");
      const submitBtn = document.getElementById("reassign-submit");
      submitBtn.disabled = true;
      submitBtn.textContent = "Updating...";
      const assetId = document.getElementById("reassign-asset").value;
      const data = Object.fromEntries(new FormData(reassignForm).entries());
      try {
        const res = await fetch(`/api/investments/rental-property/${assetId}/assign-tenant`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ tenantStakeholderId: data.tenantStakeholderId || null, monthlyRent: data.monthlyRent || null }),
        });
        const result = await res.json();
        if (!res.ok) throw new Error(result.error || "Failed to update tenancy");
        feedback.textContent = "Tenancy updated.";
        feedback.className = "text-sm p-3 rounded-lg bg-till/10 text-till";
        feedback.classList.remove("hidden");
        setTimeout(() => location.reload(), 900);
      } catch (err) {
        feedback.textContent = err.message;
        feedback.className = "text-sm p-3 rounded-lg bg-clay/10 text-clay";
        feedback.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = "Update Tenancy";
      }
    });
  }
</script>
