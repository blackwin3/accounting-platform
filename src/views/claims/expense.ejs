<header class="mb-8">
  <a href="/claims" class="text-ink/40 hover:text-till text-sm">← Claims</a>
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mt-2">Claims — <%= currentBusinessUnit %></p>
  <h1 class="font-display text-3xl mt-1">Expenses</h1>
  <p class="text-ink/50 text-sm mt-1">Rent, salaries, utilities, and other day-to-day running costs — not stock purchases.</p>
</header>

<div class="grid md:grid-cols-2 gap-6 mb-8">
  <section class="bg-white rounded-xl border border-ink/10 p-6">
    <h2 class="font-display text-xl mb-1">Record an Expense</h2>
    <p class="text-ink/50 text-sm mb-5">Posts against the matching expense account, straight out of Cash.</p>

    <form id="expense-form" class="space-y-5">
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Category</label>
        <select name="category" id="expense-category" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
          <option value="RENT">Rent</option>
          <option value="SALARIES">Salaries</option>
          <option value="UTILITIES">Utilities</option>
          <option value="TRANSPORT">Transport</option>
          <option value="INSURANCE">Insurance</option>
          <option value="TAX">Tax</option>
          <option value="OTHER">Other</option>
        </select>
      </div>
      <div id="policy-link-section" class="hidden">
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Which Policy?</label>
        <select name="moneyId" id="expense-money-id" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
          <option value="">Not linked to a specific policy</option>
          <% activePolicies.forEach(function(p) { %>
            <option value="<%= p.id %>"><%= p.name %><% if (p.premiumDue !== null) { %> — KES <%= p.premiumDue.toFixed(2) %> due<% } %></option>
          <% }) %>
        </select>
        <p class="text-xs text-ink/40 mt-1">Linking this payment lets Risks &amp; Insurance show a real payment history for the policy, not just the reference premium entered when it was created.</p>
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Amount Paid (KES)</label>
        <input name="amount" type="number" min="0.01" step="0.01" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Amount Actually Due (KES) — leave blank if same as paid</label>
        <input name="dueAmount" type="number" min="0" step="0.01" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        <p class="text-xs text-ink/40 mt-1">If you paid more than what was due, the excess is recorded as a prepaid expense (an asset, not a cost). Common for insurance, rent paid in advance, or when you're not sure of the exact amount.</p>
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-2">Payment Method</label>
        <div class="grid grid-cols-4 gap-1.5">
          <label><input type="radio" name="paymentMethod" value="CASH" checked class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Cash</div></label>
          <label><input type="radio" name="paymentMethod" value="MOBILE" class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Mobile</div></label>
          <label><input type="radio" name="paymentMethod" value="BANK" class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Bank</div></label>
          <label><input type="radio" name="paymentMethod" value="CREDIT" class="peer sr-only" /><div class="peer-checked:bg-till peer-checked:text-paper border border-ink/20 rounded-lg py-2 text-center text-xs font-medium cursor-pointer transition">Credit</div></label>
        </div>
      </div>
      <div>
        <label class="block font-mono text-xs uppercase tracking-widest text-ink/40 mb-1">Notes</label>
        <textarea name="notes" id="expense-notes" rows="2" placeholder="e.g. July shop rent, paid to landlord" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display"></textarea>
        <p id="narration-hint" class="text-xs text-ink/40 mt-1">Good notes help your accountant and future self understand what happened.</p>
      </div>

      <script>
      document.getElementById('expense-category').addEventListener('change', function() {
        const hints = {
          RENT: 'e.g. "July shop rent — paid to [landlord name]" or "3 months advance rent"',
          SALARIES: 'e.g. "June salary — [employee name]" or "Casual labour — 3 days planting"',
          UTILITIES: 'e.g. "KPLC token — KES 1000" or "Safaricom data — monthly plan"',
          TRANSPORT: 'e.g. "Fuel — 20L at KES 200/L" or "Matatu fare — Naivasha to Nairobi"',
          INSURANCE: 'e.g. "Motor insurance — comprehensive, policy #12345"',
          TAX: 'e.g. "KRA iTax — Q2 2026 VAT return" or "County business permit"',
          OTHER: 'e.g. "Lunch — KES 200" or "Office supplies" or "My time — 8hrs @ KES 750/hr"',
        };
        document.getElementById('expense-notes').placeholder = hints[this.value] || hints.OTHER;
      });
      </script>

      <button type="submit" id="submit-btn" class="w-full py-3 rounded-lg bg-clay text-paper font-display text-lg hover:brightness-110 transition">
        Record Expense
      </button>
      <div id="feedback" class="hidden text-sm p-3 rounded-lg"></div>
    </form>
  </section>

  <section class="bg-white rounded-xl border border-ink/10 p-6">
    <h2 class="font-display text-xl mb-1">Liabilities Owed</h2>
    <p class="text-ink/50 text-sm mb-5">What the business currently owes — loans and unpaid balances.</p>
    <% if (liabilities.length === 0) { %>
      <p class="text-ink/40 text-sm">Nothing outstanding.</p>
    <% } else { %>
      <div class="space-y-3">
        <% liabilities.forEach(function(l) { %>
          <div class="flex justify-between items-center py-2 border-b border-ink/5 last:border-0">
            <div>
              <p class="font-display"><%= l.type %></p>
              <p class="text-xs text-ink/40"><%= l.classification %></p>
            </div>
            <span class="font-mono tabular-nums text-clay"><%= fmt(l.amount) %></span>
          </div>
        <% }) %>
        <div class="flex justify-between pt-2 font-display">
          <span>Total Owed</span>
          <span class="font-mono tabular-nums text-clay"><%= fmt(liabilitiesTotal) %></span>
        </div>
      </div>
    <% } %>
  </section>
</div>

<section>
  <h2 class="font-display text-xl mb-4">Expense History</h2>
  <div class="bg-white rounded-xl border border-ink/10 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
          <th class="px-5 py-3">Date</th>
          <th class="px-5 py-3">Category</th>
          <th class="px-5 py-3">Status</th>
          <th class="px-5 py-3 text-right">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% expenseHistory.forEach(function(e) { %>
          <tr class="border-b border-ink/5 last:border-0 hover:bg-paper/50">
            <td class="px-5 py-3 font-mono text-xs text-ink/50"><%= e.date %></td>
            <td class="px-5 py-3 font-display"><%= e.type %></td>
            <td class="px-5 py-3">
              <% if (e.isSettled) { %>
                <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-till/10 text-till">Paid</span>
              <% } else { %>
                <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-clay/10 text-clay">Owing <%= fmt(e.outstanding) %></span>
              <% } %>
            </td>
            <td class="px-5 py-3 text-right font-mono tabular-nums text-clay"><%= fmt(e.amount) %></td>
          </tr>
        <% }) %>
        <% if (expenseHistory.length === 0) { %>
          <tr><td colspan="4" class="px-5 py-8 text-center text-ink/40">No expenses recorded for <%= currentBusinessUnit %> yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<script>
  function fmtNum(n) {
    const num = Number(n || 0);
    const sign = num < 0 ? "-" : "";
    const abs = Math.abs(num);
    const [whole, decimals] = abs.toFixed(2).split(".");
    const withCommas = whole.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    return `${sign}${withCommas}.${decimals}`;
  }

  const form = document.getElementById("expense-form");
  const categorySelect = document.getElementById("expense-category");
  const policySection = document.getElementById("policy-link-section");
  function togglePolicySection() {
    policySection.classList.toggle("hidden", categorySelect.value !== "INSURANCE");
  }
  categorySelect.addEventListener("change", togglePolicySection);
  togglePolicySection();
  const feedback = document.getElementById("feedback");
  const submitBtn = document.getElementById("submit-btn");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = "Posting...";
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch("/api/expense", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ category: data.category, amount: Number(data.amount), paymentMethod: data.paymentMethod, notes: data.notes, moneyId: data.moneyId || null }),
      });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to record expense");
      feedback.textContent = `Recorded ${data.category.toLowerCase()} expense of KES ${fmtNum(data.amount)}.`;
      feedback.className = "text-sm p-3 rounded-lg bg-till/10 text-till";
      feedback.classList.remove("hidden");
      form.reset();
      setTimeout(() => location.reload(), 800);
    } catch (err) {
      feedback.textContent = err.message;
      feedback.className = "text-sm p-3 rounded-lg bg-clay/10 text-clay";
      feedback.classList.remove("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = "Record Expense";
    }
  });
</script>
