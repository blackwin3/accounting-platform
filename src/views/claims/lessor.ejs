<header class="mb-8">
  <p class="font-mono text-xs uppercase tracking-widest text-ink/40">Resources — <%= currentBusinessUnit %></p>
  <h1 class="font-display text-3xl mt-1">Lessor</h1>
  <p class="text-ink/50 text-sm mt-1">Renting things out — the opposite of the Lease Commencement page (Claims → Leases &amp; Provisions), which is the business renting something in. Two genuinely different shapes: a specific inventory unit leased instead of sold (a car dealership's car), and owned equipment hired out repeatedly (a hardware shop's machinery).</p>
</header>

<section class="mb-10">
  <h2 class="font-display text-xl mb-1">A. Inventory Leased Out</h2>
  <p class="text-ink/50 text-sm mb-4">A specific unit, checked out instead of sold. Stays owned — unavailable, not gone — and returns to stock when it comes back.</p>
  <div class="grid md:grid-cols-2 gap-6">
    <div class="bg-white rounded-xl border border-ink/10 p-6">
      <h3 class="font-display text-lg mb-3">Lease Out a Unit</h3>
      <form id="lease-out-form" class="space-y-3">
        <select id="lease-unit" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
          <option value="">Select unit…</option>
          <% availableUnits.forEach(function(u) { %>
            <option value="<%= u.id %>"><%= u.name %> (#<%= u.id %>)</option>
          <% }) %>
        </select>
        <select id="lease-customer" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
          <option value="">Lease to…</option>
          <% customers.forEach(function(c) { %>
            <option value="<%= c.id %>"><%= c.name %></option>
          <% }) %>
        </select>
        <input id="lease-amount" type="number" min="0.01" step="0.01" required placeholder="Rental amount (KES)" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
        <select id="lease-method" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
          <option value="CASH">Cash</option>
          <option value="MOBILE">Mobile</option>
          <option value="BANK">Bank</option>
        </select>
        <input id="lease-notes" type="text" placeholder="Notes (optional)" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display" />
        <button type="submit" class="w-full py-2.5 rounded-lg bg-till text-paper font-display hover:brightness-110 transition">Lease Out</button>
        <div id="lease-out-feedback" class="hidden text-sm p-3 rounded-lg"></div>
      </form>
    </div>

    <div class="bg-white rounded-xl border border-ink/10 p-6">
      <h3 class="font-display text-lg mb-3">Currently Leased Out</h3>
      <div class="space-y-2">
        <% leasedUnits.forEach(function(u) { %>
          <div class="flex items-center justify-between border-b border-ink/5 pb-2" id="leased-row-<%= u.id %>">
            <span class="font-display text-sm"><%= u.name %> (#<%= u.id %>)</span>
            <button type="button" onclick="returnUnit(<%= u.id %>)" class="text-xs text-till hover:underline">Mark Returned</button>
          </div>
        <% }) %>
        <% if (leasedUnits.length === 0) { %>
          <p class="text-ink/40 text-sm">Nothing currently leased out.</p>
        <% } %>
      </div>
    </div>
  </div>
</section>

<section>
  <h2 class="font-display text-xl mb-1">B. Equipment For Hire</h2>
  <p class="text-ink/50 text-sm mb-4">Owned equipment (mark it on the Assets page) that cycles through many short-term renters — genuinely different from a Rental Property's one long-term tenant.</p>
  <div class="bg-white rounded-xl border border-ink/10 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-ink/10 text-left text-ink/40 font-mono text-xs uppercase tracking-widest">
          <th class="px-5 py-3">Equipment</th>
          <th class="px-5 py-3 text-right">Daily Rate</th>
          <th class="px-5 py-3">Current Renter</th>
          <th class="px-5 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% hireEquipment.forEach(function(e) { %>
          <tr class="border-b border-ink/5 last:border-0" id="equipment-row-<%= e.id %>">
            <td class="px-5 py-3 font-display"><%= e.name %></td>
            <td class="px-5 py-3 text-right font-mono tabular-nums"><%= e.dailyRate !== null ? fmt(e.dailyRate) : '—' %></td>
            <td class="px-5 py-3">
              <% if (e.renterName) { %>
                <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-till/10 text-till"><%= e.renterName %></span>
              <% } else { %>
                <span class="text-xs text-ink/40">Available</span>
              <% } %>
            </td>
            <td class="px-5 py-3 text-right">
              <% if (e.renterName) { %>
                <button type="button" onclick="endHire(<%= e.id %>)" class="text-xs text-till hover:underline">End Hire</button>
              <% } else { %>
                <button type="button" onclick="openHireOut(<%= e.id %>, '<%= e.name %>', <%= e.dailyRate || 0 %>)" class="text-xs text-till hover:underline">Hire Out</button>
              <% } %>
            </td>
          </tr>
        <% }) %>
        <% if (hireEquipment.length === 0) { %>
          <tr><td colspan="4" class="px-5 py-8 text-center text-ink/40">No equipment marked for hire yet — set Equipment_For_Hire on the Assets page for a piece of owned equipment.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<!-- Hire Out modal -->
<div id="hire-modal" class="hidden fixed inset-0 bg-ink/40 flex items-center justify-center z-50 p-4" onclick="if(event.target === this) closeHireOut()">
  <div class="bg-white rounded-xl p-6 max-w-sm w-full">
    <h3 class="font-display text-lg mb-1">Hire Out — <span id="hire-equipment-name"></span></h3>
    <form id="hire-form" class="space-y-3">
      <input type="hidden" id="hire-assets-id" />
      <select id="hire-customer" required class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
        <option value="">Hire to…</option>
        <% customers.forEach(function(c) { %>
          <option value="<%= c.id %>"><%= c.name %></option>
        <% }) %>
      </select>
      <input id="hire-amount" type="number" min="0.01" step="0.01" required placeholder="Hire amount (KES)" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-mono" />
      <select id="hire-method" class="w-full border border-ink/20 rounded-lg px-3 py-2 font-display">
        <option value="CASH">Cash</option>
        <option value="MOBILE">Mobile</option>
        <option value="BANK">Bank</option>
      </select>
      <div class="flex gap-2">
        <button type="button" onclick="closeHireOut()" class="flex-1 py-2.5 rounded-lg border border-ink/20 font-display hover:bg-paper transition">Cancel</button>
        <button type="submit" class="flex-1 py-2.5 rounded-lg bg-till text-paper font-display hover:brightness-110 transition">Hire Out</button>
      </div>
      <div id="hire-feedback" class="hidden text-sm p-3 rounded-lg"></div>
    </form>
  </div>
</div>

<script>
  document.getElementById("lease-out-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    const feedback = document.getElementById("lease-out-feedback");
    try {
      const res = await fetch("/api/lessor/lease-out", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          resourcesId: document.getElementById("lease-unit").value,
          stakeholderId: document.getElementById("lease-customer").value,
          amount: document.getElementById("lease-amount").value,
          paymentMethod: document.getElementById("lease-method").value,
          notes: document.getElementById("lease-notes").value,
        }),
      });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to lease out");
      location.reload();
    } catch (err) {
      feedback.textContent = err.message;
      feedback.className = "text-sm p-3 rounded-lg bg-clay/10 text-clay";
      feedback.classList.remove("hidden");
    }
  });

  async function returnUnit(id) {
    if (!confirm("Mark this unit as returned?")) return;
    try {
      const res = await fetch(`/api/lessor/${id}/return`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ condition: "GOOD" }) });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to return unit");
      location.reload();
    } catch (err) { alert(err.message); }
  }

  function openHireOut(id, name, rate) {
    document.getElementById("hire-assets-id").value = id;
    document.getElementById("hire-equipment-name").textContent = name;
    document.getElementById("hire-amount").value = rate || "";
    document.getElementById("hire-modal").classList.remove("hidden");
    document.getElementById("hire-feedback").classList.add("hidden");
  }
  function closeHireOut() { document.getElementById("hire-modal").classList.add("hidden"); }
  document.getElementById("hire-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    const feedback = document.getElementById("hire-feedback");
    try {
      const res = await fetch("/api/lessor/equipment/hire-out", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          assetsId: document.getElementById("hire-assets-id").value,
          stakeholderId: document.getElementById("hire-customer").value,
          amount: document.getElementById("hire-amount").value,
          paymentMethod: document.getElementById("hire-method").value,
        }),
      });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to hire out");
      location.reload();
    } catch (err) {
      feedback.textContent = err.message;
      feedback.className = "text-sm p-3 rounded-lg bg-clay/10 text-clay";
      feedback.classList.remove("hidden");
    }
  });

  async function endHire(id) {
    if (!confirm("End this equipment hire?")) return;
    try {
      const res = await fetch(`/api/lessor/equipment/${id}/end-hire`, { method: "POST" });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to end hire");
      location.reload();
    } catch (err) { alert(err.message); }
  }
</script>
