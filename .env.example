# Local development (used by docker-compose)
DB_USER=accounting
DB_PASSWORD=change-me
DB_NAME=family_accounting

# Production (Render sets DATABASE_URL directly)
DATABASE_URL=postgresql://accounting:change-me@db:5432/family_accounting?schema=public

# Required in production — generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# Optional
NODE_ENV=development
PORT=3000
